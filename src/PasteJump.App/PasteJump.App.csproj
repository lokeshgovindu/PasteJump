<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PasteJump</AssemblyName>
    <RootNamespace>PasteJump.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\pastejump.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Self-contained portable-folder publish: no .NET runtime required on the
    target machine. Trimming and NativeAOT are BOTH unsupported with WPF -
    do not enable them, the ~110-150 MB output is the cost of the UI framework.
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    The WPF implicit-usings set does not include System.IO (unlike the plain library set), and
    this app touches the filesystem in several places. Added once here rather than as a using
    directive repeated across every view and service.
  -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <!--
    pastejump.ico is shipped three ways on purpose, and each one is reachable only by its own
    mechanism - which is why this looks redundant and is not.

    ApplicationIcon    puts it in the PE header. That is what Explorer, the taskbar and Alt+Tab read.
                       NOT reachable through a pack:// URI, so XAML cannot bind to this copy.
    Resource           makes it addressable as pack://application:,,,/PasteJump;component/... which is
                       what Themes/Shared.xaml's AppIcon key - and therefore every window's title-bar
                       icon - resolves against.
    Content            copies it loose beside the executable, which is what the notification area
                       needs: TrayIcon calls LoadImage(LR_LOADFROMFILE) so it can ask for the icon at
                       the shell's current small-icon metric. Extracting the PE copy instead would
                       hand back a fixed 16x16 that the shell then upscales, and at 150% scaling -
                       where it wants 24 - that is visibly blurry.
  -->
  <ItemGroup>
    <Resource Include="Assets\pastejump.ico" />
    <Content Include="Assets\pastejump.ico" CopyToOutputDirectory="PreserveNewest" />

    <!--
      Greyed variant for the tray while PasteJump is disabled. Content only: no window shows it, so it needs
      no pack:// URI. Unlike the pair of monochrome glyphs this project used to carry, the two are not a
      light/dark theme split - they are two application states, and picking between them is not something a
      single icon can do.
    -->
    <Content Include="Assets\pastejump-disabled.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PasteJump.Core\PasteJump.Core.csproj" />
    <ProjectReference Include="..\PasteJump.Interop\PasteJump.Interop.csproj" />
    <ProjectReference Include="..\PasteJump.Import\PasteJump.Import.csproj" />
  </ItemGroup>

</Project>
