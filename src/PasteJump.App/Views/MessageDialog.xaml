<Window x:Class="PasteJump.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PasteJump"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        MaxWidth="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">

    <!--
        Replaces MessageBox for the app's own prompts.

        Win32 draws MessageBox itself, so it follows neither the palette nor anything else about this app: in
        dark mode it was the one light-on-light surface in the product, and its buttons are whatever the OS
        supplies. Getting the ComCtl32 v6 manifest right made it look modern rather than pre-XP, but modern
        and *ours* are different things, and no manifest will make it honour a theme the OS does not know about.
    -->

    <Window.Resources>
        <!-- BasedOn is mandatory: a window-level implicit style replaces the app-level one outright rather
             than merging, so without it these would discard the themed ControlTemplates. -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            The glyph is a bare coloured character rather than a character inside a filled disc. A filled
            disc needs a foreground that contrasts with every fill in both themes, and the warning amber in
            particular carries neither white nor black text well. Unfilled sidesteps the whole problem and
            still reads instantly.
        -->
        <TextBlock x:Name="GlyphText"
                   Grid.Row="0"
                   Grid.Column="0"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,-2,16,0"
                   VerticalAlignment="Top"
                   TextWrapping="NoWrap" />

        <StackPanel Grid.Row="0" Grid.Column="1">
            <TextBlock x:Name="HeadlineText"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Visibility="Collapsed" />

            <TextBlock x:Name="BodyText"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="12.5"
                       LineHeight="18" />
        </StackPanel>

        <StackPanel x:Name="Buttons"
                    Grid.Row="1"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0" />
    </Grid>
</Window>
