<Window x:Class="PasteJump.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PasteJump - Clipboard History"
        Width="1260"
        Height="770"
        MinWidth="680"
        MinHeight="400"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- BasedOn is required: see the note in SettingsWindow.xaml. -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="84" />
        </Style>

        <!--
            No implicit ComboBox or TextBox style here, deliberately. The toolbar's two editors need a height
            matching its 32px buttons, and setting that window-wide was a bug: it also caught the multi-line
            PreviewBox in the preview pane, which with 10px of padding left no room for a line of text, so the
            preview went blank for every text entry. The height is set on those two controls directly instead -
            a keyed style would not do either, since a keyed Style replaces the themed implicit one outright
            and would take the ControlTemplate with it.
        -->
    </Window.Resources>

    <Window.InputBindings>
        <!-- Both, because muscle memory differs: Ctrl+E is the Explorer/Office convention and Ctrl+K
             the editor one (VS Code, Slack, browsers). Neither is used for anything else here. -->
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <!--
                The search box takes the star, not the middle. It used to be a fixed 320 in an Auto column with
                the gap between them starred, which meant the toolbar had no give: adding one button pushed the
                total past the window width and the squeeze landed on the density label, which clipped to "y"
                while the search box overlapped it. A field that narrows is the right thing to sacrifice.
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="150" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!--
                    One window, two stores. A switch rather than a second window because the two are constantly
                    confused - a clip deleted from the stack is still in history, and clearing history shortens
                    neither - and seeing them in the same grid, with the same columns, is what makes the
                    difference legible rather than something to be explained.
                -->
                <ComboBox x:Name="ViewCombo"
                          MinHeight="32"
                          Width="120"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"
                          SelectionChanged="OnViewChanged"
                          ToolTip="Clips are what Ctrl+V pastes from, with every clipboard format intact. History is the searchable log, which keeps a flattened record.">
                    <ComboBoxItem Content="Clips" />
                    <ComboBoxItem Content="History" IsSelected="True" />
                </ComboBox>

                <!--
                    Kind, beside the store switch rather than out with Density: both answer "what am I looking at",
                    while Density answers "how does it look". The gesture has the same filter on its K key and the
                    same four states, from the same PasteKindFilter in Core - one definition, so the window and the
                    gesture cannot disagree about what "images" means.
                -->
                <ComboBox x:Name="KindCombo"
                          MinHeight="32"
                          Width="104"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"
                          SelectionChanged="OnKindFilterChanged"
                          ToolTip="Show only one kind of clip. The same filter is on the K key during the gesture. It is not remembered between openings, deliberately: a window that opened with most of its rows hidden would read as data lost." />

                <Button x:Name="PinButton"
                        Click="OnPinClicked"
                        Content="_Pin"
                        Visibility="Collapsed"
                        ToolTip="Pin or unpin the selected clips. Pinned clips sort first and survive Delete All." />
                <Button x:Name="CopyButton"
                        Click="OnCopyClicked"
                        Content="_Copy"
                        ToolTip="Put the selected entry back on the clipboard (Enter, or double-click a row)" />
                <Button x:Name="DeleteButton"
                        Click="OnDeleteClicked"
                        Content="_Delete"
                        ToolTip="Remove the selected entries from history (Delete)" />
                <Button x:Name="DeduplicateButton"
                        Click="OnDeduplicateClicked"
                        Content="Remove D_uplicates"
                        ToolTip="Collapse entries that are exact duplicates, keeping one of each. Acts on whichever of the two stores is shown. Imports before this version were not idempotent, so importing Clipjump more than once left a copy per run." />
                <!--
                    "Ignore time" used to sit here, beside the button. It is inside the Remove Duplicates prompt
                    now, which is where the decision is actually made - a check box on a toolbar is a setting you
                    have to notice before acting, while one in the prompt is part of answering the question. It
                    also keeps this toolbar to buttons that do things.
                -->
                <Button x:Name="ClearButton"
                        Click="OnClearClicked"
                        Content="Clear _History"
                        ToolTip="Remove every entry from the searchable history archive. The clips Ctrl+V walks are a separate store and are not affected." />
            </StackPanel>

            <!--
                Density, here as well as in Settings. It is the one setting whose whole effect is visible in
                this window, so choosing it anywhere else means opening a dialog to change a number and then
                looking somewhere else to judge it. Both places write the same setting and each follows the
                other while open.
            -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,10,0">
                <TextBlock Text="Density"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox x:Name="DensityCombo" MinHeight="32"
                          Width="104"
                          VerticalAlignment="Center"
                          SelectionChanged="OnDensityChanged"
                          ToolTip="Row spacing for this list. Compact fits the most rows; Roomy is the easiest to hit with a mouse. Saved as a setting." />
            </StackPanel>

            <!-- Search box with a cue banner. WPF has no native placeholder, so the hint is a
                 TextBlock layered behind the box and hidden as soon as there is text. -->
            <!-- Stretched, with no MaxWidth and no alignment. Both were tried and both shrink it to its content:
                 an aligned element sizes to what it wants, and MaxWidth inside a stretched slot centres what is
                 left over. Filling the remainder is what a search field should do anyway. -->
            <Grid Grid.Column="2">
                <TextBox x:Name="SearchBox" MinHeight="32" VerticalAlignment="Center"
                         Padding="26,2,24,2"
                         TextChanged="OnSearchTextChanged"
                         ToolTip="Search history by content. Ctrl+E, Ctrl+K or Ctrl+F to jump here; Esc to clear." />

                <Button x:Name="SearchClear"
                        Style="{StaticResource SearchClearButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        Visibility="Collapsed"
                        Click="OnSearchClearClicked" />

                <TextBlock Style="{StaticResource SearchGlyph}" />

                <!-- 27, not the 7 this used to be plus the new padding: the text origin is Padding plus the 1px
                     border, which also quietly fixes a one-pixel disagreement with the settings dialog's cue. -->
                <TextBlock x:Name="SearchCue"
                           Text="Search history…  (Ctrl+K)"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="27,0,0,0"
                           Padding="0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <!-- Split: list on the left, preview on the right -->
        <Grid Grid.Row="1">
            <!--
                The list takes a fixed width and the preview takes the rest, rather than the two splitting the
                window evenly as they did. Measured from a screenshot of the split the user asked for: 551px of
                list in a 1254px window, so 552 here. Absolute rather than a share of the width because the list's
                columns are fixed - widening the window should give the room to the picture, which is what it is
                for, not to the Content column. The splitter still moves it, and where it is left is remembered.
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="552" MinWidth="300" />
                <!-- 6px is the grab area, not the visible divider: the seam drawn inside it is 1px. -->
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!--
                Almost every visual property now comes from the themed DataGrid styles rather than being
                set here. Setting them locally would beat the style and re-break the theming, which is
                how the grid ended up looking unstyled in the first place.
            -->
            <DataGrid x:Name="EntriesGrid"
                      Grid.Column="0"
                      SelectionMode="Extended"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionChanged="OnSelectionChanged"
                      PreviewMouseRightButtonDown="OnRowRightButtonDown"
                      ContextMenuOpening="OnRowMenuOpening"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Columns>
                    <!-- Position in history, newest first. Deliberately NOT recomputed when a column
                         is sorted: it identifies the entry, so a stable number is more useful than a
                         display index that shifts under every sort. -->
                    <DataGridTextColumn Header="No."
                                        Binding="{Binding Number}"
                                        Width="48"
                                        SortMemberPath="Number"
                                        ElementStyle="{StaticResource MutedCellText}" />

                    <!-- Every column needs an ElementStyle based on CellText, so its Foreground tracks
                         the owning cell and therefore changes with selection. See the note on
                         CellText in Themes/Controls.xaml. -->
                    <DataGridTextColumn Header="Content"
                                        Binding="{Binding SingleLinePreview}"
                                        Width="*"
                                        SortMemberPath="SingleLinePreview"
                                        ElementStyle="{StaticResource CellText}" />

                    <DataGridTextColumn Header="Kind"
                                        Binding="{Binding KindText}"
                                        Width="56"
                                        SortMemberPath="Kind"
                                        ElementStyle="{StaticResource CellText}" />

                    <!--
                        Width is a starting point only: the format is the machine's own now, so its width is
                        not knowable here. WhenColumn is measured and widened at load - see MeasureWhenColumn.
                    -->
                    <DataGridTextColumn x:Name="WhenColumn"
                                        Header="When"
                                        Binding="{Binding LocalTimeText}"
                                        Width="116"
                                        SortMemberPath="CapturedUtc"
                                        ElementStyle="{StaticResource CellText}" />

                    <!-- Right-aligned, and sorted by the underlying byte count rather than by the
                         formatted string - otherwise "9 B" sorts after "10 KB". -->
                    <DataGridTextColumn Header="Size"
                                        Binding="{Binding SizeText}"
                                        Width="74"
                                        SortMemberPath="Bytes"
                                        ElementStyle="{StaticResource NumericCellText}">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>

                <!--
                    The row menu. Every item does exactly what a toolbar button or the Kind combo does - nothing is
                    reachable only from here - because a menu that is the sole route to an action is one that people
                    who never right-click never find. On the grid rather than in the RowStyle: a Style setter shares
                    one instance across every row regardless, and this way the items have names, which is what lets
                    ContextMenuOpening set them to match the selection.

                    Themed for free: the ContextMenu and MenuItem templates the tray menu needed apply to every menu
                    in the application.
                -->
                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="RowMenu">
                        <MenuItem x:Name="RowCopyItem" Header="_Copy" InputGestureText="Enter" Click="OnCopyClicked" />
                        <MenuItem x:Name="RowPinItem" Header="_Pin" Click="OnPinClicked" />
                        <MenuItem x:Name="RowDeleteItem" Header="_Delete" InputGestureText="Del" Click="OnDeleteClicked" />
                        <Separator />
                        <MenuItem x:Name="RowFilterKindItem" Header="Show Only This _Kind" Click="OnFilterToRowKindClicked" />
                        <MenuItem x:Name="RowClearFilterItem" Header="Show _All Kinds" Click="OnClearKindFilterClicked" />
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <!--
                            Pinned rows are tinted rather than given a column. The column that used to carry
                            "PINNED" was empty in every History row and in every unpinned clip - which is almost
                            all of them - so it spent its width saying nothing, and was reported as such.

                            ModifiedRowBrush rather than a new palette key: it is the same idea the Advanced tab
                            uses for a row that differs from its default, a soft accent band that survives both
                            themes. Selection and hover paint over it, which is correct - the pin is the least
                            important thing about a row you are acting on. The tooltip says PINNED in words, so the
                            state is never carried by colour alone.
                        -->
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ModifiedRowBrush}" />
                            </DataTrigger>
                        </Style.Triggers>

                        <!--
                            Per-row tooltip: the full untruncated preview, and for an image row a medium thumbnail
                            above it, so hovering the list is enough to find a picture without selecting each one.

                            The thumbnail loads only when the tooltip is realised, because that is when this binding
                            first asks for it - see HistoryRow.Thumbnail. A DataTrigger hides the Image when there
                            is none, which beats a converter for one comparison against null.
                        -->
                        <Setter Property="ToolTip">
                            <Setter.Value>
                                <ToolTip>
                                    <StackPanel MaxWidth="420">
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="Uniform"
                                               StretchDirection="DownOnly"
                                               HorizontalAlignment="Left"
                                               MaxHeight="200"
                                               Margin="0,0,0,6">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Text="{Binding TooltipText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ToolTip>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- Background and Width come from the themed style: a transparent 6px grab area with a
                 1px seam painted inside it. Setting Background here would paint over the seam. -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          ToolTip="Drag to resize the list and preview panes" />

            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                <Grid>
                    <!--
                        Two rows: the header and the content. There used to be a third for a footer carrying the
                        resolution and a byte count, and the byte count all but repeated the header's own - which
                        was reported. The resolution moved up into the header, beside the kind it describes, and the
                        footer went with the duplication.
                    -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="3,3,0,0"
                            Padding="10,0"
                            MinHeight="32">
                        <TextBlock x:Name="PreviewHeader"
                                   Text="Preview"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!--
                        Two rows rather than one overlapping pair, because a copied image FILE needs both at
                        once: its path above and a thumbnail of it below. An image clip uses only the second,
                        and text only the first, so each row's height is set per selection in ShowPreview.
                    -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="PreviewTextRow" Height="*" />
                            <RowDefinition x:Name="PreviewImageRow" Height="0" />
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="PreviewScroller"
                                      Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBox x:Name="PreviewBox"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextBrush}"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     Padding="10"
                                     AcceptsReturn="True"
                                     ToolTip="Full content of the selected entry. Read-only, but selectable." />
                        </ScrollViewer>

                        <!--
                            The picture, in a scroller so it can be zoomed past the pane and panned.

                            LayoutTransform rather than RenderTransform, deliberately: only a layout transform
                            changes the size the ScrollViewer measures, so the scrollbars and the pannable extent
                            follow the zoom for free. With a render transform the image would grow visually and the
                            scroller would still believe it was the old size, leaving most of a zoomed picture
                            unreachable.

                            Stretch=None at all times - fitting is done by computing a scale rather than by letting
                            the Image stretch, so the percentage readout can tell the truth in Fit mode too.
                        -->
                        <!--
                            UseLayoutRounding is what makes a picture at 100% actually crisp, and its absence is
                            why one looked blurry. The Image is centred, so the space left over is split in two -
                            and whenever that leftover is an odd number of pixels the image starts on a HALF pixel.
                            WPF then resamples the whole bitmap to draw it there, which on a screenshot of text is
                            plainly visible and reads as "100% is not really 100%". Rounding the layout puts the
                            image on whole pixels, so 1:1 really is 1:1.
                        -->
                        <Grid x:Name="PreviewImageHost" Grid.Row="1" Visibility="Collapsed" UseLayoutRounding="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer x:Name="ImageScroller"
                                          Grid.Row="0"
                                          Margin="10,10,10,0"
                                          Focusable="True"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="OnImageMouseWheel"
                                          PreviewMouseLeftButtonDown="OnImagePanStart"
                                          PreviewMouseMove="OnImagePanMove"
                                          PreviewMouseLeftButtonUp="OnImagePanEnd"
                                          MouseDoubleClick="OnImageDoubleClick"
                                          KeyDown="OnImageKeyDown"
                                          SizeChanged="OnImageViewportChanged">
                                <Image x:Name="PreviewImage"
                                       Stretch="None"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       ToolTip="Scroll with Ctrl to zoom, drag to pan, double-click for 100%">
                                    <Image.LayoutTransform>
                                        <ScaleTransform x:Name="ImageScale" />
                                    </Image.LayoutTransform>
                                </Image>
                            </ScrollViewer>

                            <!--
                                Zoom controls. Only ever visible with a picture, since the host they live in is
                                collapsed otherwise - so a text clip's pane gains nothing to ignore.
                            -->
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,6,0,4">
                                <Button x:Name="ZoomFitButton"
                                        Content="_Fit"
                                        Click="OnZoomFit"
                                        MinWidth="46"
                                        Padding="8,2"
                                        Margin="0,0,4,0"
                                        FontSize="11"
                                        ToolTip="Fit the picture to the pane (0)" />
                                <Button x:Name="ZoomActualButton"
                                        Content="100%"
                                        Click="OnZoomActual"
                                        MinWidth="46"
                                        Padding="8,2"
                                        Margin="0,0,4,0"
                                        FontSize="11"
                                        ToolTip="Show every pixel, one for one (1)" />
                                <Button Content="−"
                                        Click="OnZoomOut"
                                        MinWidth="28"
                                        Padding="8,2"
                                        Margin="0,0,4,0"
                                        FontSize="11"
                                        ToolTip="Zoom out (Ctrl+scroll down)" />
                                <Button Content="+"
                                        Click="OnZoomIn"
                                        MinWidth="28"
                                        Padding="8,2"
                                        Margin="0,0,8,0"
                                        FontSize="11"
                                        ToolTip="Zoom in (Ctrl+scroll up)" />
                                <TextBlock x:Name="ZoomReadout"
                                           VerticalAlignment="Center"
                                           MinWidth="42"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <!-- Status -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="2,10,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="11" />
    </Grid>
</Window>
