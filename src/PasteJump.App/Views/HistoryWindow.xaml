<Window x:Class="PasteJump.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PasteJump - Clipboard History"
        Width="1020"
        Height="640"
        MinWidth="680"
        MinHeight="400"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- BasedOn is required: see the note in SettingsWindow.xaml. -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="84" />
        </Style>

        <!--
            No implicit ComboBox or TextBox style here, deliberately. The toolbar's two editors need a height
            matching its 32px buttons, and setting that window-wide was a bug: it also caught the multi-line
            PreviewBox in the preview pane, which with 10px of padding left no room for a line of text, so the
            preview went blank for every text entry. The height is set on those two controls directly instead -
            a keyed style would not do either, since a keyed Style replaces the themed implicit one outright
            and would take the ControlTemplate with it.
        -->
    </Window.Resources>

    <Window.InputBindings>
        <!-- Both, because muscle memory differs: Ctrl+E is the Explorer/Office convention and Ctrl+K
             the editor one (VS Code, Slack, browsers). Neither is used for anything else here. -->
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <!--
                The search box takes the star, not the middle. It used to be a fixed 320 in an Auto column with
                the gap between them starred, which meant the toolbar had no give: adding one button pushed the
                total past the window width and the squeeze landed on the density label, which clipped to "y"
                while the search box overlapped it. A field that narrows is the right thing to sacrifice.
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="150" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!--
                    One window, two stores. A switch rather than a second window because the two are constantly
                    confused - a clip deleted from the stack is still in history, and clearing history shortens
                    neither - and seeing them in the same grid, with the same columns, is what makes the
                    difference legible rather than something to be explained.
                -->
                <ComboBox x:Name="ViewCombo"
                          MinHeight="32"
                          Width="120"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"
                          SelectionChanged="OnViewChanged"
                          ToolTip="Clips are what Ctrl+V pastes from, with every clipboard format intact. History is the searchable log, which keeps a flattened record.">
                    <ComboBoxItem Content="Clips" />
                    <ComboBoxItem Content="History" IsSelected="True" />
                </ComboBox>

                <Button x:Name="PinButton"
                        Click="OnPinClicked"
                        Content="_Pin"
                        Visibility="Collapsed"
                        ToolTip="Pin or unpin the selected clips. Pinned clips sort first and survive Delete All." />
                <Button x:Name="CopyButton"
                        Click="OnCopyClicked"
                        Content="_Copy"
                        ToolTip="Put the selected entry back on the clipboard (Enter, or double-click a row)" />
                <Button x:Name="DeleteButton"
                        Click="OnDeleteClicked"
                        Content="_Delete"
                        ToolTip="Remove the selected entries from history (Delete)" />
                <Button x:Name="DeduplicateButton"
                        Click="OnDeduplicateClicked"
                        Content="Remove D_uplicates"
                        ToolTip="Collapse entries that are exact duplicates, keeping one of each. Acts on whichever of the two stores is shown. Imports before this version were not idempotent, so importing Clipjump more than once left a copy per run." />
                <!--
                    "Ignore time" used to sit here, beside the button. It is inside the Remove Duplicates prompt
                    now, which is where the decision is actually made - a check box on a toolbar is a setting you
                    have to notice before acting, while one in the prompt is part of answering the question. It
                    also keeps this toolbar to buttons that do things.
                -->
                <Button x:Name="ClearButton"
                        Click="OnClearClicked"
                        Content="Clear _History"
                        ToolTip="Remove every entry from the searchable history archive. The clips Ctrl+V walks are a separate store and are not affected." />
            </StackPanel>

            <!--
                Density, here as well as in Settings. It is the one setting whose whole effect is visible in
                this window, so choosing it anywhere else means opening a dialog to change a number and then
                looking somewhere else to judge it. Both places write the same setting and each follows the
                other while open.
            -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,10,0">
                <TextBlock Text="Density"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox x:Name="DensityCombo" MinHeight="32"
                          Width="104"
                          VerticalAlignment="Center"
                          SelectionChanged="OnDensityChanged"
                          ToolTip="Row spacing for this list. Compact fits the most rows; Roomy is the easiest to hit with a mouse. Saved as a setting." />
            </StackPanel>

            <!-- Search box with a cue banner. WPF has no native placeholder, so the hint is a
                 TextBlock layered behind the box and hidden as soon as there is text. -->
            <!-- Stretched, with no MaxWidth and no alignment. Both were tried and both shrink it to its content:
                 an aligned element sizes to what it wants, and MaxWidth inside a stretched slot centres what is
                 left over. Filling the remainder is what a search field should do anyway. -->
            <Grid Grid.Column="2">
                <TextBox x:Name="SearchBox" MinHeight="32" VerticalAlignment="Center"
                         Padding="5,2,24,2"
                         TextChanged="OnSearchTextChanged"
                         ToolTip="Search history by content. Ctrl+E, Ctrl+K or Ctrl+F to jump here; Esc to clear." />

                <Button x:Name="SearchClear"
                        Style="{StaticResource SearchClearButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        Visibility="Collapsed"
                        Click="OnSearchClearClicked" />

                <TextBlock x:Name="SearchCue"
                           Text="Search history…  (Ctrl+K)"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="7,0,0,0"
                           Padding="0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <!-- Split: list on the left, preview on the right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="300" />
                <!-- 6px is the grab area, not the visible divider: the seam drawn inside it is 1px. -->
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!--
                Almost every visual property now comes from the themed DataGrid styles rather than being
                set here. Setting them locally would beat the style and re-break the theming, which is
                how the grid ended up looking unstyled in the first place.
            -->
            <DataGrid x:Name="EntriesGrid"
                      Grid.Column="0"
                      SelectionMode="Extended"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionChanged="OnSelectionChanged"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Columns>
                    <!-- Position in history, newest first. Deliberately NOT recomputed when a column
                         is sorted: it identifies the entry, so a stable number is more useful than a
                         display index that shifts under every sort. -->
                    <DataGridTextColumn Header="No."
                                        Binding="{Binding Number}"
                                        Width="52"
                                        SortMemberPath="Number"
                                        ElementStyle="{StaticResource MutedCellText}" />

                    <!-- Every column needs an ElementStyle based on CellText, so its Foreground tracks
                         the owning cell and therefore changes with selection. See the note on
                         CellText in Themes/Controls.xaml. -->
                    <DataGridTextColumn Header="Content"
                                        Binding="{Binding SingleLinePreview}"
                                        Width="*"
                                        SortMemberPath="SingleLinePreview"
                                        ElementStyle="{StaticResource CellText}" />

                    <DataGridTextColumn Header="Kind"
                                        Binding="{Binding KindText}"
                                        Width="70"
                                        SortMemberPath="Kind"
                                        ElementStyle="{StaticResource CellText}" />

                    <!-- Empty for a history entry, which cannot be pinned. Kept in both views rather than
                         swapped in and out, so the column layout does not shift when the view changes. -->
                    <DataGridTextColumn Header=""
                                        Binding="{Binding PinnedText}"
                                        Width="58"
                                        SortMemberPath="Pinned"
                                        ElementStyle="{StaticResource MutedCellText}" />

                    <DataGridTextColumn Header="When"
                                        Binding="{Binding LocalTimeText}"
                                        Width="150"
                                        SortMemberPath="CapturedUtc"
                                        ElementStyle="{StaticResource CellText}" />

                    <!-- Right-aligned, and sorted by the underlying byte count rather than by the
                         formatted string - otherwise "9 B" sorts after "10 KB". -->
                    <DataGridTextColumn Header="Size"
                                        Binding="{Binding SizeText}"
                                        Width="86"
                                        SortMemberPath="Bytes"
                                        ElementStyle="{StaticResource NumericCellText}">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <!-- Per-row tooltip showing the full, untruncated preview. -->
                        <Setter Property="ToolTip" Value="{Binding TooltipText}" />
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- Background and Width come from the themed style: a transparent 6px grab area with a
                 1px seam painted inside it. Setting Background here would paint over the seam. -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          ToolTip="Drag to resize the list and preview panes" />

            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="3,3,0,0"
                            Padding="10,0"
                            MinHeight="32">
                        <TextBlock x:Name="PreviewHeader"
                                   Text="Preview"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!--
                        Two rows rather than one overlapping pair, because a copied image FILE needs both at
                        once: its path above and a thumbnail of it below. An image clip uses only the second,
                        and text only the first, so each row's height is set per selection in ShowPreview.
                    -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="PreviewTextRow" Height="*" />
                            <RowDefinition x:Name="PreviewImageRow" Height="0" />
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="PreviewScroller"
                                      Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBox x:Name="PreviewBox"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextBrush}"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     Padding="10"
                                     AcceptsReturn="True"
                                     ToolTip="Full content of the selected entry. Read-only, but selectable." />
                        </ScrollViewer>

                        <Image x:Name="PreviewImage"
                               Grid.Row="1"
                               Margin="10"
                               Stretch="Uniform"
                               StretchDirection="DownOnly"
                               Visibility="Collapsed"
                               ToolTip="Image for this entry" />
                    </Grid>

                    <!--
                        Dimensions on the left, bytes on the right - the two facts you want about an image and
                        cannot get from the picture itself. Collapsed for anything that is not an image, rather
                        than showing empty fields.
                    -->
                    <Border x:Name="PreviewFooter"
                            Grid.Row="2"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,3,3"
                            Padding="10,0"
                            MinHeight="28"
                            Visibility="Collapsed">
                        <Grid>
                            <TextBlock x:Name="PreviewDimensions"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11" />
                            <TextBlock x:Name="PreviewBytes"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="2,10,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="11" />
    </Grid>
</Window>
