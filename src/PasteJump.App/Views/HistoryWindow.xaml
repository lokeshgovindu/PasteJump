<Window x:Class="PasteJump.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PasteJump - Clipboard History"
        Width="1020"
        Height="640"
        MinWidth="680"
        MinHeight="400"
        Background="{DynamicResource SurfaceBrush}"
        Icon="{DynamicResource AppIcon}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- BasedOn is required: see the note in SettingsWindow.xaml. -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="84" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <!-- Both, because muscle memory differs: Ctrl+E is the Explorer/Office convention and Ctrl+K
             the editor one (VS Code, Slack, browsers). Neither is used for anything else here. -->
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="CopyButton"
                        Click="OnCopyClicked"
                        Content="_Copy"
                        ToolTip="Put the selected entry back on the clipboard (Enter, or double-click a row)" />
                <Button x:Name="DeleteButton"
                        Click="OnDeleteClicked"
                        Content="_Delete"
                        ToolTip="Remove the selected entries from history (Delete)" />
                <Button x:Name="ClearButton"
                        Click="OnClearClicked"
                        Content="Clear _all"
                        ToolTip="Remove every entry from history. This cannot be undone." />
            </StackPanel>

            <!-- Search box with a cue banner. WPF has no native placeholder, so the hint is a
                 TextBlock layered behind the box and hidden as soon as there is text. -->
            <Grid Grid.Column="2" Width="320">
                <TextBox x:Name="SearchBox"
                         TextChanged="OnSearchTextChanged"
                         ToolTip="Search history by content. Ctrl+E, Ctrl+K or Ctrl+F to jump here; Esc to clear." />

                <TextBlock x:Name="SearchCue"
                           Text="Search history…  (Ctrl+K)"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="7,0,0,0"
                           Padding="0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <!-- Split: list on the left, preview on the right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="300" />
                <!-- 6px is the grab area, not the visible divider: the seam drawn inside it is 1px. -->
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!--
                Almost every visual property now comes from the themed DataGrid styles rather than being
                set here. Setting them locally would beat the style and re-break the theming, which is
                how the grid ended up looking unstyled in the first place.
            -->
            <DataGrid x:Name="EntriesGrid"
                      Grid.Column="0"
                      SelectionMode="Extended"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionChanged="OnSelectionChanged"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Columns>
                    <!-- Position in history, newest first. Deliberately NOT recomputed when a column
                         is sorted: it identifies the entry, so a stable number is more useful than a
                         display index that shifts under every sort. -->
                    <DataGridTextColumn Header="No."
                                        Binding="{Binding Number}"
                                        Width="52"
                                        SortMemberPath="Number"
                                        ElementStyle="{StaticResource MutedCellText}" />

                    <!-- Every column needs an ElementStyle based on CellText, so its Foreground tracks
                         the owning cell and therefore changes with selection. See the note on
                         CellText in Themes/Controls.xaml. -->
                    <DataGridTextColumn Header="Content"
                                        Binding="{Binding SingleLinePreview}"
                                        Width="*"
                                        SortMemberPath="SingleLinePreview"
                                        ElementStyle="{StaticResource CellText}" />

                    <DataGridTextColumn Header="Kind"
                                        Binding="{Binding KindText}"
                                        Width="70"
                                        SortMemberPath="Kind"
                                        ElementStyle="{StaticResource CellText}" />

                    <DataGridTextColumn Header="When"
                                        Binding="{Binding LocalTimeText}"
                                        Width="150"
                                        SortMemberPath="CapturedUtc"
                                        ElementStyle="{StaticResource CellText}" />

                    <!-- Right-aligned, and sorted by the underlying byte count rather than by the
                         formatted string - otherwise "9 B" sorts after "10 KB". -->
                    <DataGridTextColumn Header="Size"
                                        Binding="{Binding SizeText}"
                                        Width="86"
                                        SortMemberPath="Bytes"
                                        ElementStyle="{StaticResource NumericCellText}">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <!-- Per-row tooltip showing the full, untruncated preview. -->
                        <Setter Property="ToolTip" Value="{Binding TooltipText}" />
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- Background and Width come from the themed style: a transparent 6px grab area with a
                 1px seam painted inside it. Setting Background here would paint over the seam. -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          ToolTip="Drag to resize the list and preview panes" />

            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="3,3,0,0"
                            Padding="10,0"
                            MinHeight="32">
                        <TextBlock x:Name="PreviewHeader"
                                   Text="Preview"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="PreviewScroller"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBox x:Name="PreviewBox"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextBrush}"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     Padding="10"
                                     AcceptsReturn="True"
                                     ToolTip="Full content of the selected entry. Read-only, but selectable." />
                        </ScrollViewer>

                        <Image x:Name="PreviewImage"
                               Margin="10"
                               Stretch="Uniform"
                               StretchDirection="DownOnly"
                               Visibility="Collapsed"
                               ToolTip="Stored image for this entry" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="2,10,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="11" />
    </Grid>
</Window>
