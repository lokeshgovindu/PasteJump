<Window x:Class="PasteJump.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PasteJump Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!--
        On ShowInTaskbar="False" above. Every window PasteJump shows appears in the taskbar EXCEPT this one
        and the toast, so that a window can never be lost behind another with no way back to it. These two
        are the exception because they are not windows anyone tracks: this one lives for the length of a
        keypress, and a taskbar button appearing and vanishing on every gesture would be worse than useless.
        WindowInterop.MakeNonActivating also applies WS_EX_TOOLWINDOW here, which keeps it out of Alt+Tab and
        is load-bearing for focus - so do not "fix" this to match the other windows.
    -->

    <!--
        Two things make this text legible, and the second one is the larger half.

        TextFormattingMode=Display: WPF's default Ideal mode is tuned for large text and renders 11-12px UI
        text soft. This window is nothing but small text, so it matters here most.

        And NO AllowsTransparency. WPF renders a layered window's text with greyscale antialiasing instead of
        ClearType, so the TextRenderingMode request below is only honoured because this window is opaque. The
        rounded corners and the drop shadow come from DWM instead - see WindowInterop.ApplyRoundedCorners. Do
        not reintroduce AllowsTransparency to get a CornerRadius back; that is the trade that made this soft.

        This window is also click-through, via WS_EX_TRANSPARENT in code-behind. That is a hit-testing flag
        and is unrelated to AllowsTransparency, which is about per-pixel alpha - dropping one does not affect
        the other, despite the shared word.
    -->

    <!--
        ShowActivated=False and Focusable=False are necessary but not sufficient - WS_EX_NOACTIVATE
        is applied in code-behind as well. Without it a click or certain focus events can still
        bring this window forward, and the moment that happens the paste lands in the overlay
        instead of the user's document.
    -->

    <!-- No CornerRadius and no DropShadowEffect: DWM provides both for the window itself now. A rounded
         Border inside a square opaque window would only show the window's own background in the corners. -->
    <!-- MaxWidth is set from the preview size in ApplyPreviewSize: a wider preview than the window allows would
         simply be clipped, so the two cannot be configured independently. -->
    <Border x:Name="RootBorder"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="0"
            MaxWidth="560">

        <StackPanel>

            <!-- Header: position, mode, formatter, flags -->
            <!-- Square: DWM clips the window to its rounded shape, so the top corners are already taken care
                 of. A CornerRadius here would round the header inside an already-rounded window and leave two
                 slivers of the outer Border's fill showing. -->
            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                    Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PositionText"
                               Grid.Column="0"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="Clip 1 of 1" />

                    <!--
                        The right margin is load-bearing, not decoration. The window is SizeToContent, so
                        with a short preview the star column has no slack to give and the last chip here -
                        the source application's name - ends up flush against the formatter chip in the next
                        column, reading as one run-together word.
                    -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="10,0,14,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="PinnedChip"
                                   Style="{StaticResource ChipText}"
                                   Foreground="{DynamicResource WarnBrush}"
                                   Margin="0,0,8,0"
                                   Visibility="Collapsed"
                                   Text="PINNED" />
                        <TextBlock x:Name="TagsChip"
                                   Style="{StaticResource ChipText}"
                                   Margin="0,0,8,0"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="SourceChip"
                                   Style="{StaticResource ChipText}"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!--
                            Not optional decoration. A kind filter with no visible sign of itself is a stack that
                            has silently lost most of its clips, which is the one way this feature could read as a
                            bug. Accent-coloured rather than muted for the same reason.
                        -->
                        <TextBlock x:Name="KindFilterChip"
                                   Style="{StaticResource ChipText}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,8,0"
                                   Visibility="Collapsed" />
                        <!--
                            Marks change what releasing Ctrl does, so they are not optional decoration either:
                            a session that pastes three clips while the preview shows one would read as the wrong
                            clip being pasted. It carries the count, and a tick when THIS clip is one of them -
                            the count alone would not say whether pressing the key again adds or removes.
                        -->
                        <TextBlock x:Name="JoinChip"
                                   Style="{StaticResource ChipText}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,8,0"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="PopChip"
                                   Style="{StaticResource ChipText}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   Margin="0,0,8,0"
                                   Visibility="Collapsed"
                                   Text="POP" />
                        <TextBlock x:Name="FormatterChip"
                                   Style="{StaticResource ChipText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Commit-mode banner. Only shown once X has been pressed, because it is the only
                 signal that releasing Ctrl will destroy rather than paste. -->
            <Border x:Name="ModeBanner"
                    Background="{DynamicResource DangerBrush}"
                    Padding="10,4"
                    Visibility="Collapsed">
                <TextBlock x:Name="ModeText"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="SemiBold" />
            </Border>

            <!-- Search box. Not a real input control: it mirrors a query assembled from hook
                 events, precisely so this window never needs focus. -->
            <Border x:Name="SearchRow"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="0,1,0,1"
                    Padding="10,5"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Search"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <TextBlock x:Name="SearchQueryText"
                               Grid.Column="1"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock x:Name="MatchCountText"
                               Grid.Column="2"
                               Style="{StaticResource ChipText}" />
                </Grid>
            </Border>

            <!--
                Body: text, or a thumbnail, or - for a copied image file - the path with a thumbnail beneath it
                and its dimensions and size below that. Stacked rows rather than overlapping children, because
                that third case needs two of them visible at once.
            -->
            <Grid Margin="10,8,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PreviewText"
                           Grid.Row="0"
                           Foreground="{DynamicResource TextBrush}"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap"
                           MaxHeight="400"
                           LineHeight="16" />

                <!--
                    Centred, not left-aligned. The overlay's width is set by whichever row is widest - the header with
                    its chips, or the facts row underneath - so a picture narrower than those sat against the left edge
                    with a gap beside it, which reads as a layout fault rather than as a small picture. Centring also
                    suits the copied-image-file case, where the thumbnail sits under its path like a caption above it.
                -->
                <Image x:Name="PreviewImage"
                       Grid.Row="1"
                       MaxHeight="400"
                       MaxWidth="600"
                       Stretch="Uniform"
                       StretchDirection="DownOnly"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed" />

                <!--
                    A copied TEXT file's contents, in the same slot the thumbnail of a copied image file uses -
                    the path stays above in PreviewText and this appears beneath it. Muted rather than the ordinary
                    text colour, because it is the file's content rather than the clip's: what a paste puts on the
                    clipboard is the path.
                -->
                <TextBlock x:Name="PreviewFileText"
                           Grid.Row="1"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="NoWrap"
                           MaxHeight="260"
                           LineHeight="16"
                           Margin="0,6,0,0"
                           Visibility="Collapsed" />

                <!-- Dimensions left, bytes right: the two facts a picture cannot tell you about itself. -->
                <Grid x:Name="ImageFacts" Grid.Row="2" Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ImageDimensions"
                               HorizontalAlignment="Left"
                               Style="{StaticResource ChipText}" />
                    <TextBlock x:Name="ImageBytes"
                               HorizontalAlignment="Right"
                               Style="{StaticResource ChipText}" />
                </Grid>

                <TextBlock x:Name="EmptyText"
                           Grid.Row="0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12"
                           FontStyle="Italic"
                           Visibility="Collapsed"
                           Text="No clips" />
            </Grid>

            <!--
                The key hint. It exists because two features were reported as missing while both already
                worked: jumping back to the newest clip, and reading the key list mid-gesture. Nothing on
                screen said so, and a gesture nobody sees a menu for has to carry its own signposts.

                Deliberately the four that matter when you are lost rather than the whole list: get back,
                get out, and where to find the rest. 10px and muted so it reads as a footnote.
            -->
            <TextBlock x:Name="KeyHintText"
                       Margin="10,0,10,8"
                       Foreground="{DynamicResource TextBrush}"
                       TextWrapping="Wrap"
                       FontSize="12" />

        </StackPanel>
    </Border>
</Window>
