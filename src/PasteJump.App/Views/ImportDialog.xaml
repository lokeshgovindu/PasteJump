<Window x:Class="PasteJump.App.Views.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PasteJump - import history"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">

    <!--
        A window of its own rather than a MessageDialog with an extra button, because the folder is data the
        user may need to change rather than a fact to accept. Auto-detection is a heuristic - Clipjump ships
        as a portable folder with no installer and no registry entry, so there is nothing authoritative to
        query - and when the guess is wrong the user needs a way to say where it actually is.
    -->

    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,5" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,18,20,16">

        <TextBlock Text="Import from Clipjump?"
                   Foreground="{DynamicResource TextBrush}"
                   FontSize="14"
                   FontWeight="SemiBold" />

        <TextBlock Margin="0,10,0,0"
                   Foreground="{DynamicResource TextBrush}"
                   FontSize="12.5"
                   LineHeight="18"
                   Text="Both the history archive and the clip stack are imported, so imported clips can be pasted with the gesture and not merely searched. Nothing in the Clipjump folder is modified. Entries already imported are skipped, so running this twice is harmless." />

        <TextBlock Margin="0,16,0,4"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="11"
                   Text="Clipjump folder" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FolderBox"
                     Grid.Column="0"
                     TextChanged="OnFolderChanged"
                     FontFamily="Consolas"
                     ToolTip="The folder containing Clipjump.exe. It must have a cache\data.db inside it." />

            <Button x:Name="BrowseButton"
                    Grid.Column="1"
                    Click="OnBrowseClicked"
                    Content="_Browse…"
                    MinWidth="96"
                    Margin="8,0,0,0" />
        </Grid>

        <!-- Says why Import is unavailable rather than just disabling it, which on its own reads as a bug. -->
        <TextBlock x:Name="StatusText"
                   Margin="0,8,0,0"
                   FontSize="11" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ImportButton"
                    Click="OnImportClicked"
                    Content="_Import"
                    IsDefault="True"
                    MinWidth="96" />
            <Button Content="_Cancel"
                    Click="OnCancelClicked"
                    IsCancel="True"
                    MinWidth="88"
                    Margin="8,0,0,0" />
        </StackPanel>

    </StackPanel>
</Window>
