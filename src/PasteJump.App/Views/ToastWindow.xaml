<Window x:Class="PasteJump.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PasteJump Notification"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceRaisedBrush}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!--
        Two things make this text legible, and it took both.

        TextFormattingMode=Display: WPF's default is Ideal, which preserves exact glyph advances for faithful
        scaling and is visibly soft at the 11-12px this window uses. Display snaps advances to whole pixels.

        And NO AllowsTransparency. That was the larger half and the less obvious one: WPF renders a layered
        window's text with greyscale antialiasing instead of ClearType, so asking for ClearType on a
        transparent window achieves nothing at all. The window is now opaque, and the rounded corners and drop
        shadow come from DWM instead - see WindowInterop.ApplyRoundedCorners. Do not reintroduce
        AllowsTransparency here to get a rounded corner back; that is the trade that made the text soft.
    -->

    <!--
        Clipjump's post-copy tooltip (Clipjump.ahk:499, cleared by a 500ms TooltipOff timer), rebuilt
        as a real window so it can be themed and can show a preview rather than a bare string.

        It carries the same non-activating window traits as the overlay, applied properly in
        code-behind. That is not optional: a notification that steals focus at the exact moment the
        user is copying would send their next keystroke here instead of into their document.
    -->
    <!-- No CornerRadius and no DropShadowEffect: DWM provides both for the window itself now. A rounded Border
         inside a square opaque window would just show the window's own background in the corners. -->
    <Border Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="12,9"
            MaxWidth="420">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Accent bar, so the notification reads as PasteJump's at a glance. -->
            <Border Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Width="3"
                    CornerRadius="2"
                    Margin="0,1,10,1"
                    Background="{DynamicResource AccentBrush}" />

            <TextBlock x:Name="HeadlineText"
                       Grid.Row="0"
                       Grid.Column="1"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock x:Name="DetailText"
                       Grid.Row="1"
                       Grid.Column="1"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontFamily="Consolas"
                       FontSize="11"
                       Margin="0,3,0,0"
                       MaxHeight="48"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
