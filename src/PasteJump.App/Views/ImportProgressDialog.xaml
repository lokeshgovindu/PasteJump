<Window x:Class="PasteJump.App.Views.ImportProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PasteJump - importing"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource SurfaceBrush}"
        Icon="{DynamicResource AppIcon}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">

    <!--
        Exists because the import can be slow through no fault of its own. A Clipjump folder in OneDrive is a
        tree of cloud placeholders, so the database copy and every image row can each block on a download -
        which, run inline on the UI thread, presented as PasteJump hanging. The work now runs on a worker and
        this window is the only thing on the UI thread, so it stays responsive and Cancel actually works.

        The bar is two Borders rather than a ProgressBar: the app defines no themed ProgressBar template, so a
        real one would bring WPF's default light chrome into a dark window.
    -->

    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,18,20,16">

        <TextBlock x:Name="HeadlineText"
                   Foreground="{DynamicResource TextBrush}"
                   FontSize="13"
                   Text="Importing Clipjump's history…" />

        <Border Margin="0,14,0,0"
                Height="6"
                CornerRadius="3"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1">
            <!-- Left-aligned so the fill grows rightwards from a width set in code. -->
            <Border x:Name="ProgressFill"
                    HorizontalAlignment="Left"
                    Width="0"
                    CornerRadius="3"
                    Background="{DynamicResource AccentBrush}" />
        </Border>

        <TextBlock x:Name="DetailText"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="11" />

        <Button x:Name="CancelButton"
                Click="OnCancelClicked"
                Content="_Cancel"
                IsCancel="True"
                HorizontalAlignment="Right"
                MinWidth="88"
                Padding="14,5"
                Margin="0,18,0,0" />

    </StackPanel>
</Window>
