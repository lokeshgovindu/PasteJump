<Window x:Class="PasteJump.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PasteJump"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Icon="{DynamicResource AppIcon}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!--
            BasedOn is mandatory. A window-level implicit style REPLACES the app-level one for that type
            rather than merging with it, so leaving it off here would discard the themed template from
            Themes/Controls.xaml and paint WPF's built-in light chrome instead.
        -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">

        <StackPanel Orientation="Horizontal">
            <!--
                The same pastejump.ico the tray, the taskbar and every title bar use. Rendered at 48
                from an icon file that carries a 48 frame, so this is a straight blit rather than an
                upscale of the 16.
            -->
            <Image Source="{DynamicResource AppIcon}"
                   Width="48"
                   Height="48"
                   VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="PasteJump"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12"
                           Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="0,16,0,0"
                   Foreground="{DynamicResource TextBrush}"
                   FontSize="12"
                   Text="A keyboard-driven multiple-clipboard manager. Hold Ctrl, tap V to step back through what you have copied, release to paste." />

        <TextBlock Margin="0,10,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="11">
            <Run Text="A ground-up reimplementation of Clipjump by Avi Aryan, from observed behaviour." />
            <LineBreak />
            <Run Text="No Clipjump code was copied." />
        </TextBlock>

        <TextBlock x:Name="CopyrightText"
                   Margin="0,14,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="11" />

        <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}">
            <Hyperlink x:Name="RepositoryLink"
                       NavigateUri="https://github.com/lokeshgovindu/PasteJump"
                       RequestNavigate="OnRequestNavigate"
                       Foreground="{DynamicResource AccentBrush}">github.com/lokeshgovindu/PasteJump</Hyperlink>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CopyDetailsButton"
                    Click="OnCopyDetailsClicked"
                    Content="Copy _details"
                    MinWidth="96"
                    Padding="14,5"
                    ToolTip="Copies the version and environment details, for pasting into a bug report" />
            <!--
                Needs the Click handler. IsCancel sets DialogResult, which only exists for a window shown with
                ShowDialog; this one is shown with Show, so without a handler neither the button nor Esc does
                anything. IsCancel stays because it is what routes Esc here.
            -->
            <Button Content="_Close"
                    Click="OnCloseClicked"
                    IsCancel="True"
                    IsDefault="True"
                    MinWidth="84"
                    Padding="14,5"
                    Margin="6,0,0,0" />
        </StackPanel>

    </StackPanel>
</Window>
