<Window x:Class="PasteJump.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PasteJump"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!--
            BasedOn is mandatory. A window-level implicit style REPLACES the app-level one for that type
            rather than merging with it, so leaving it off here would discard the themed template from
            Themes/Controls.xaml and paint WPF's built-in light chrome instead.
        -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">

        <StackPanel Orientation="Horizontal">
            <!--
                AppIconLarge, not AppIcon: the latter is the multi-frame .ico, and WPF's icon decoder chose a
                small frame and scaled it up, which is what made this look soft. This is a single 256px PNG
                rendered down to 64 - always the cleaner direction. See the note in Themes/Shared.xaml.
            -->
            <Image Source="{DynamicResource AppIconLarge}"
                   Width="64"
                   Height="64"
                   VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <!--
                    The product name IS the repository link, rather than a bare URL on a line of its own at the
                    bottom. Same place the eye already is, and it reads as a title instead of as an address.
                -->
                <TextBlock FontSize="20" FontWeight="SemiBold">
                    <Hyperlink NavigateUri="https://github.com/lokeshgovindu/PasteJump"
                               RequestNavigate="OnRequestNavigate"
                               ToolTip="github.com/lokeshgovindu/PasteJump">PasteJump</Hyperlink>
                </TextBlock>
                <TextBlock x:Name="VersionText"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12"
                           Margin="0,2,0,0" />
                <TextBlock x:Name="BuildText"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11"
                           Margin="0,1,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="0,16,0,0"
                   Foreground="{DynamicResource TextBrush}"
                   FontSize="12"
                   Text="A keyboard-driven multiple-clipboard manager. Hold Ctrl, tap V to step back through what you have copied, release to paste." />

        <TextBlock Margin="0,10,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="11">
            <Run Text="A ground-up reimplementation of Clipjump by Avi Aryan, from observed behaviour." />
            <LineBreak />
            <Run Text="No Clipjump code was copied." />
        </TextBlock>

        <!-- Inlines are built in code: the author's name inside the copyright line is a link, and both the
             line and the name come from assembly attributes rather than being spelt out twice. -->
        <TextBlock x:Name="CopyrightText"
                   Margin="0,14,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="11" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CopyDetailsButton"
                    Click="OnCopyDetailsClicked"
                    Content="Copy _Details"
                    MinWidth="96"
                    Padding="14,5"
                    ToolTip="Copies the version and environment details, for pasting into a bug report" />
            <!--
                Needs the Click handler. IsCancel sets DialogResult, which only exists for a window shown with
                ShowDialog; this one is shown with Show, so without a handler neither the button nor Esc does
                anything. IsCancel stays because it is what routes Esc here.
            -->
            <Button Content="_Close"
                    Click="OnCloseClicked"
                    IsCancel="True"
                    IsDefault="True"
                    MinWidth="84"
                    Padding="14,5"
                    Margin="6,0,0,0" />
        </StackPanel>

    </StackPanel>
</Window>
