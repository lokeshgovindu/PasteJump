<Window x:Class="PasteJump.App.Views.ShortcutHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PasteJump - Paste-mode keys"
        Width="640"
        SizeToContent="Height"
        MaxHeight="820"
        MinWidth="480"
        MinHeight="300"
        ResizeMode="CanResize"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="KeyStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,14,4" />
        </Style>
        <Style x:Key="DescStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
    </Window.Resources>

    <!--
        The buttons are OUTSIDE the ScrollViewer, in their own row. The list now exceeds MaxHeight, so with
        everything in one scrolling StackPanel the window opened with no Close button in sight - the reader had
        to scroll to the end of a reference card to find the way out of it.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- Text set in code-behind: the trigger key is configurable, so it cannot be literal here. -->
            <TextBlock x:Name="IntroText"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="13"
                       TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource SectionStyle}" Text="MOVING THROUGH CLIPS" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <!--
                        Wide enough for the longest entry, which is the search row's "Ctrl+V / Ctrl+C" - and
                        that one grows with the configurable trigger key, so it is not a string that can be
                        eyeballed once and forgotten. Fixed rather than Auto because each section is its own
                        Grid, and Auto would let the key columns disagree between sections.
                    -->
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    <RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>

                <!-- Both key columns are set in code-behind here, because each names the configurable trigger. -->
                <TextBlock x:Name="TriggerKeyText" Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Step to an older clip" />

                <!-- Every key column below is set in code-behind: the letters are configurable. -->
                <TextBlock x:Name="KeyBack" Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Step back to a newer clip" />

                <TextBlock x:Name="KeyNewest" Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Jump to the newest clip" />

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="End" />
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Jump to the oldest clip" />

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="1 – 9" />
                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Jump that many clips" />

                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="–" />
                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Reverse the direction the number keys jump in" />
            </Grid>

            <TextBlock Style="{StaticResource SectionStyle}" Text="PASTING" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <!--
                        Wide enough for the longest entry, which is the search row's "Ctrl+V / Ctrl+C" - and
                        that one grows with the configurable trigger key, so it is not a string that can be
                        eyeballed once and forgotten. Fixed rather than Auto because each section is its own
                        Grid, and Auto would let the key columns disagree between sections.
                    -->
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="release Ctrl" />
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Paste the shown clip" />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="+ Shift" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Press Shift once paste mode is already open, then release, to delete the clip after pasting (paste popping). Ctrl+Shift+V is left alone — it belongs to terminals and to paste-as-plain-text." />

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Enter" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Paste and stay open, to paste several clips in a row" />

                <TextBlock x:Name="KeyFormat" Grid.Row="3" Grid.Column="0" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Cycle paste format: Original, Plain text, Collapse whitespace, Sentence case, Unindent" />

                <TextBlock x:Name="KeyClipboard" Grid.Row="4" Grid.Column="0" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Put the clip on the Windows clipboard without pasting it" />

                <!-- In PASTING rather than ORGANISING: marking is not something done TO a clip, it is a decision
                     about what the next paste will contain. -->
                <TextBlock x:Name="KeyJoin" Grid.Row="5" Grid.Column="0" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Mark this clip. Releasing Ctrl pastes every marked clip as ONE clip, in the order you marked them, joined by the separator set in Settings, History. A JOIN chip counts them; press again to unmark. Marks last only for this gesture." />
            </Grid>

            <TextBlock Style="{StaticResource SectionStyle}" Text="ORGANISING" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <!--
                        Wide enough for the longest entry, which is the search row's "Ctrl+V / Ctrl+C" - and
                        that one grows with the configurable trigger key, so it is not a string that can be
                        eyeballed once and forgotten. Fixed rather than Auto because each section is its own
                        Grid, and Auto would let the key columns disagree between sections.
                    -->
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock x:Name="KeyPin" Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Pin or unpin. Pinned clips sort first and survive Delete All" />

                <TextBlock x:Name="KeyFront" Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Move this clip to the front of the stack" />

                <TextBlock x:Name="KeyTags" Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Edit tags" />

                <TextBlock x:Name="KeyEditor" Grid.Row="3" Grid.Column="0" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Open the clip in an external editor" />

                <TextBlock x:Name="KeyExport" Grid.Row="4" Grid.Column="0" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Export the clip to a file" />

                <TextBlock x:Name="KeyHistory" Grid.Row="5" Grid.Column="0" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Open the clipboard history window. Ends the gesture, since that window takes the keyboard" />
            </Grid>

            <TextBlock Style="{StaticResource SectionStyle}" Text="SEARCH" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <!--
                        Wide enough for the longest entry, which is the search row's "Ctrl+V / Ctrl+C" - and
                        that one grows with the configurable trigger key, so it is not a string that can be
                        eyeballed once and forgotten. Fixed rather than Auto because each section is its own
                        Grid, and Auto would let the key columns disagree between sections.
                    -->
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock x:Name="KeySearch" Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Open search. Ctrl can be released - just type to filter by content or tag" />

                <TextBlock x:Name="KeyKind" Grid.Row="5" Grid.Column="0" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Show only one kind of clip: all, then text, images, files. A chip names the filter, and it resets each time the gesture opens" />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Backspace" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Delete a character from the query" />

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Enter" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Paste the match" />

                <TextBlock x:Name="SearchStepText" Grid.Row="3" Grid.Column="0" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Move between matches while searching" />

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Esc" />
                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Cancel" />
            </Grid>

            <TextBlock Style="{StaticResource SectionStyle}" Text="DELETING" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <!--
                        Wide enough for the longest entry, which is the search row's "Ctrl+V / Ctrl+C" - and
                        that one grows with the configurable trigger key, so it is not a string that can be
                        eyeballed once and forgotten. Fixed rather than Auto because each section is its own
                        Grid, and Auto would let the key columns disagree between sections.
                    -->
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Delete" />
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DescStyle}"
                           Text="Delete this clip straight away and carry on browsing. DELETED appears for a moment, and releasing Ctrl then pastes nothing - deleting a clip is not a request to paste the one that moved up into its place. Step to another clip and releasing pastes again." />

                <TextBlock x:Name="KeyCommit" Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DescStyle}"
                           Text="Cycle what releasing Ctrl will do: Cancel, then Delete this clip, then Delete All. A banner shows the current mode. Pressing X repeatedly cycles between those three and never returns to pasting." />

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Esc" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DescStyle}" Text="Cancel immediately and restore the previous clipboard" />
            </Grid>

            <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,16,0,0"
                       Text="Clipjump's channels, plugins and Action Mode are not implemented, so its PitSwap key is absent and the X cycle has no Move or Copy stages. Its Up and Down channel keys step through clips here instead." />
        </StackPanel>
    </ScrollViewer>

    <!--
        Click handler as well as IsCancel on Close. IsCancel alone closes nothing here: it sets DialogResult,
        which only exists for a window shown with ShowDialog, and this one is shown with Show. So the button and
        the Esc key both did nothing at all. IsCancel is kept because it is what routes Esc to this button in
        the first place.
    -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,8,16,16">

        <!--
            The route from "which key was it" to the full manual. F1 lands here rather than on the manual, so
            this button is what makes the longer document reachable without going to the tray - and the caller
            passes null to hide it when there is no .chm, because a button that can only ever apologise is
            worse than no button.
        -->
        <Button x:Name="ManualButton"
                Content="Open the Full _Manual"
                Click="OnManualClicked"
                MinWidth="84"
                Padding="14,5"
                Margin="0,0,8,0" />

        <Button Content="_Close"
                Click="OnCloseClicked"
                IsCancel="True"
                IsDefault="True"
                MinWidth="84"
                Padding="14,5" />
    </StackPanel>
    </Grid>
</Window>
