<Window x:Class="PasteJump.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PasteJump - Settings"
        Width="900"
        Height="660"
        MinWidth="740"
        MinHeight="500"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        FontSize="13">

    <!--
        Tabbed rather than one long column. With five groups the single-column form ran taller than a
        1080p screen could show at 125% scaling, and SizeToContent="Height" meant it simply grew off
        the bottom edge with no scrollbar. A fixed height plus tabs keeps every setting reachable.

        Every setting carries its explanation inline, beneath the control, rather than only in a tooltip.
        A tooltip has to be discovered by hovering and waiting, so it does nothing for the case that
        actually matters - reading a label and drawing the wrong conclusion from it. "Maximum clips kept"
        was misread as the history size; the text under it now says which store it governs. Tooltips are
        kept for the longer caveats that would bloat the page.
    -->

    <Window.Resources>
        <!--
            Each of these MUST carry BasedOn. A window-level implicit style replaces the app-level one
            for that type outright rather than merging with it, so without BasedOn these would discard
            the themed ControlTemplates in Themes/Controls.xaml and the controls would fall back to
            WPF's built-in light chrome - the exact problem the theming work was fixing.
        -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="84" />
        </Style>

        <!--
            One explicit height for both editors. They were 28 and 35 - measured off a screenshot, not guessed -
            because nothing was making them agree: the themed ComboBox carries MinHeight="24" and sits at its own
            desired height, while a TextBox defaults to VerticalAlignment="Stretch" and grew to fill the row.
            MinHeight cannot fix that, since the taller control was already above any floor worth setting.

            VerticalAlignment="Center" is the whole fix, and it is the only thing set. It stops a TextBox
            stretching to fill its row - which is what made the two disagree, 28 against 35 - and once neither
            stretches they size to their content and arrive at the same height on their own: both templates spend
            8px of vertical padding and 2px of border around one line of text, so equal fonts give equal heights.

            No height of any kind, after two attempts that each caused a visible fault. Height="30" clipped the
            values, because a hard height leaves the content whatever is left after chrome and 20px is not enough
            for an 18px line box once rounding is against you. MinHeight="32" cured the clipping and then padded
            every control with 4px of slack it had no use for. Constraining nothing is what fits the text exactly,
            and it is also the only version that follows a font size change without being retuned.
        -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="MinHeight" Value="27" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="MinHeight" Value="27" />
        </Style>

        <!-- Label / editor row. Every setting below uses this shape, so it is defined once. -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>

        <!--
            The inline explanation under a setting. Top-aligned, unlike the implicit TextBlock style it
            derives from: help text is usually two lines and centring it against a one-line label reads as
            a mistake. The bottom margin is what separates one setting from the next, so it is deliberately
            larger than the top one - it groups each help line with the control above it rather than
            floating midway between two.
        -->
        <Style x:Key="SettingHelp" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,3,0,12" />
        </Style>

        <!-- Same, indented to start under a check box's label rather than under its box. -->
        <Style x:Key="CheckHelp" TargetType="TextBlock" BasedOn="{StaticResource SettingHelp}">
            <Setter Property="Margin" Value="23,3,0,12" />
        </Style>

        <!--
            A resolved path that opens in Explorer when clicked. Styled by hand rather than with a Hyperlink,
            because there is no themed Hyperlink in Controls.xaml and an unstyled one renders in WPF's built-in
            blue - illegible on the dark palette, which is the failure mode this project keeps meeting. Accent
            colour, a hand cursor and an underline on hover carry the affordance without a new control type.
        -->
        <Style x:Key="PathLink" TargetType="TextBlock" BasedOn="{StaticResource SettingHelp}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Section heading within a tab, for the few places a tab holds more than one group. -->
        <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <!-- Tab pages scroll. Inline help roughly doubles the height of every setting, and a page that
             silently cuts off its last control is worse than one you have to scroll. -->
        <!--
            The Advanced grid's headers, lifted to match this dialog's text. Overridden here rather than in
            Themes/Controls.xaml because the DataGrid styles are shared with the History window and the app
            picker, neither of which asked to grow. BasedOn is not optional: a window-level implicit style
            replaces the app-level one outright rather than merging, so omitting it would discard the themed
            template and leave WPF's built-in header chrome.
        -->
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!--
            The per-row Reset button on the Advanced page. Sized down hard: the themed Button's own padding is
            tuned for a dialog footer and would push every grid row taller than the density the rest of the
            dialog uses. BasedOn is mandatory - a keyed style without it replaces the themed template rather
            than extending it, and the button would render in WPF's built-in chrome.

            Hidden unless the row differs from its default. A Reset button on a row already at its default
            would be a control that does nothing, repeated forty times down the page.
        -->
        <Style x:Key="RowResetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsModified}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabScroller" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="0,0,10,0" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <!--
            The same three chords the history window uses, deliberately: muscle memory differs - Ctrl+E is the
            Explorer and Office convention, Ctrl+K the editor one (VS Code, Slack, browsers) - and a shortcut that
            works in one window of an application and not the other is worse than none.

            All three reach the box at the top, never the Advanced tab's filter, even while that tab is selected.
            One chord with two possible destinations depending on where you are is not a shortcut anyone can trust.
        -->
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Search across every tab. Above the TabControl rather than on a tab of its own, because the point is to
            find a setting without knowing which tab it is on - a search you have to navigate to first would not
            answer the question that prompted it.

            The results popup is anchored to this box and placed by the code-behind. StaysOpen is false so clicking
            anywhere else dismisses it.
        -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Padding on the right leaves room for the clear button, so a long query cannot run underneath it. -->
            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Padding="5,2,24,2"
                     TextChanged="OnSearchTextChanged"
                     PreviewKeyDown="OnSearchKeyDown"
                     ToolTip="Find a setting on any tab by its name or its description" />

            <Button x:Name="SearchClear"
                    Grid.Column="0"
                    Style="{StaticResource SearchClearButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"
                    Visibility="Collapsed"
                    Click="OnSearchClearClicked" />

            <!--
                Cue text over the empty box. IsHitTestVisible="False" so it cannot steal a click.

                Margin 6, not 7: the themed TextBox insets its text by Padding 5 plus a 1px border, so 7 put the
                placeholder one pixel right of where typing actually starts and the text appeared to shift as you
                began. Whatever this is, it must equal the TextBox's own text origin - a placeholder that does not
                sit exactly where the text will reads as a stray indent.
            -->
            <TextBlock x:Name="SearchCue"
                       Grid.Column="0"
                       Text="Search settings…  (Ctrl+K)"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False" />

            <TextBlock x:Name="SearchCount"
                       Grid.Column="1"
                       Style="{StaticResource SettingHelp}"
                       Margin="10,0,2,0"
                       VerticalAlignment="Center" />

            <Popup x:Name="SearchPopup"
                   PlacementTarget="{Binding ElementName=SearchBox}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   MaxHeight="320">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Padding="1">
                    <ListBox x:Name="SearchResults"
                             MinWidth="420"
                             MaxHeight="300"
                             BorderThickness="0"
                             MouseUp="OnSearchResultClicked"
                             KeyDown="OnSearchResultKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinWidth="400">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TabName}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="12"
                                               Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>

        <TabControl x:Name="Tabs" Grid.Row="1">

            <!-- ==================================================== Capture -->
            <TabItem Header="Cap_ture">
                <ScrollViewer Style="{StaticResource TabScroller}">
                    <StackPanel>

                        <CheckBox x:Name="MonitorClipboardCheck" Content="Watch the Clipboard" />
                        <TextBlock Style="{StaticResource CheckHelp}"
                                   Text="When off, PasteJump stops recording what you copy but stays running, and the Ctrl+V gesture still works on the clips it already holds. Identical to Pause in the tray menu." />

                        <CheckBox x:Name="StoreImagesCheck" Content="Store Images" />
                        <TextBlock Style="{StaticResource CheckHelp}"
                                   Text="Images arrive from the clipboard uncompressed, so a screenshot can be several megabytes where a page of text is a few kilobytes. Turn this off to keep only text and file lists." />

                        <CheckBox x:Name="AllowDuplicatesCheck" Content="Record a Repeated Copy as a New Clip" />
                        <TextBlock Style="{StaticResource CheckHelp}"
                                   Text="Off, recommended: copying the same thing twice moves the existing clip back to the front instead of adding a second copy. On: every copy becomes its own entry, so the stack fills with duplicates." />

                        <CheckBox x:Name="LimitMaxClipsCheck"
                                  Content="Limit the Number of Clips Kept"
                                  Checked="OnLimitMaxClipsChanged"
                                  Unchecked="OnLimitMaxClipsChanged" />
                        <TextBlock Style="{StaticResource CheckHelp}"
                                   Margin="23,3,0,4"
                                   Text="Off keeps every clip for ever. Worth leaving on — nothing else bounds this store, and because images are stored uncompressed a handful of screenshots costs more than thousands of text clips." />

                        <!-- Indented under its checkbox, as the original arranges it: the number only means
                             anything while the limit is switched on. -->
                        <Grid Style="{StaticResource SettingRow}" Margin="23,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MaxClipsLabel" Grid.Column="0" Text="Clips Kept in the Stack" />
                            <TextBox x:Name="MaxClipsBox" Grid.Column="1" />
                        </Grid>

                        <TextBlock x:Name="MaxClipsHelp"
                                   Style="{StaticResource CheckHelp}"
                                   Text="How many clips the Ctrl+V gesture can walk back through before the oldest is discarded. This is the working stack only — it does not limit the searchable history archive, which has its own setting on the History tab. Pinned clips never count towards this and are never discarded." />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================================================== History -->
            <TabItem Header="_History">
                <ScrollViewer Style="{StaticResource TabScroller}">
                    <StackPanel>

                        <CheckBox x:Name="RecordHistoryCheck" Content="Keep a Searchable History Archive" />
                        <TextBlock Style="{StaticResource CheckHelp}"
                                   Text="A long-term log, separate from the clip stack: entries stay here after they have been pushed out of the stack, and it is what the history window searches. Turn this off to keep only the stack." />

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Days of History to Keep" />
                            <TextBox x:Name="RetentionDaysBox" Grid.Column="1" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="Entries older than this are removed. 0 keeps everything for ever. Pruning runs once at start-up rather than on a timer, so a change takes effect the next time PasteJump starts." />

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Characters Kept per Entry" />
                            <TextBox x:Name="PreviewMaxCharsBox" Grid.Column="1" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="How much of a long clip is stored in the searchable preview, between 256 and 65536. This is also how far into a clip search can reach, since only the preview is indexed. Text beyond it is still archived whole, so Copy always returns the complete clip — raising this costs database size, not safety. Applies to new captures." />

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Rows the History Window Loads" />
                            <TextBox x:Name="HistoryLoadLimitBox" Grid.Column="1" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="A safeguard against an enormous archive making the window slow to open, between 100 and 1000000. The window says so when it is showing a subset. The list virtualises rows, so a high value costs little." />

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Preview Image Width (px)" />
                            <TextBox x:Name="HistoryPreviewWidthBox" Grid.Column="1" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="How large an image is decoded for the history preview pane, between 120 and 4096. Higher is sharper on a high-resolution screen and slower per row selected. Smaller images are never enlarged past their own size." />

                        <!--
                            Wider than the numeric boxes beside it: a separator can be a phrase rather than a
                            character, and a few words in a 96px box show about half of themselves.
                        -->
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Separator When Joining Clips" />
                            <TextBox x:Name="ClipJoinSeparatorBox" Grid.Column="1" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="What goes between clips when several rows are selected in the history window and copied as one. Write invisible characters as \n for a new line, \r\n, \t for a tab, and \\ for a backslash; anything else is used literally, so &quot;, &quot; or &quot; — &quot; work as typed. Emptying the box restores a new line, since joining with nothing runs the clips together." />

                        <TextBlock Style="{StaticResource SectionHeading}" Text="Import from Clipjump" />
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Margin="0,3,0,8"
                                   Text="Copies Clipjump's history archive and its clip stack into PasteJump, so imported clips can be pasted with the gesture and not merely searched. Nothing in the Clipjump folder is modified. Entries already imported are skipped, so running it twice is harmless." />

                        <Button x:Name="ImportButton"
                                Click="OnImportClicked"
                                Content="_Import Clipjump History…"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,0"
                                MinWidth="200"
                                ToolTip="Finds an existing Clipjump installation, and lets you browse to one if the guess is wrong." />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================================================== Paste mode -->
            <TabItem Header="_Paste Mode">
                <ScrollViewer Style="{StaticResource TabScroller}">
                    <StackPanel>

                        <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Hold Ctrl and Tap This Key" />
                            <!--
                                Disabled rather than removed, deliberately: it still shows what the trigger
                                actually is, which is worth reading even when it cannot be changed. Left in
                                place for a future release. The value is still collected from the combo on OK,
                                so what is displayed is what gets saved - nothing to carry forward by hand.
                            -->
                            <ComboBox x:Name="TriggerKeyCombo"
                                      Grid.Column="1"
                                      IsEnabled="False"
                                      SelectionChanged="OnTriggerKeyChanged" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Margin="0,3,0,2"
                                   Text="The key that opens paste mode, and that steps to an older clip once it is open. Not adjustable in this release — shown so you can see what the gesture is." />
                        <TextBlock x:Name="TriggerKeyHintText"
                                   Style="{StaticResource SettingHelp}"
                                   Margin="0,0,0,2" />

                        <!--
                            The other gesture keys are only listed in the Paste-mode keys dialog, which nobody
                            has a reason to open. That was reported the hard way: someone met paste popping by
                            accident and had nowhere to look it up. Naming the dialog here is the smallest fix
                            that does not duplicate the whole list.
                        -->
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Margin="0,0,0,12"
                                   Text="Once paste mode is open, other keys act on the clip — X cycles cancel and delete, F searches, Z changes the format, Space pins, and Shift deletes the clip after pasting. The full list is under Paste-mode Keys in the tray menu, or press F1 during the gesture. Ctrl+Shift+V is deliberately left to the application, since terminals paste with it." />

                        <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Keystroke Sent to Paste" />
                            <ComboBox x:Name="PasteKeystrokeCombo" Grid.Column="1" IsEnabled="False" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="What PasteJump presses in the target application once it has put your clip on the clipboard. Not adjustable in this release — Shift+Insert was offered as a way to coexist with another clipboard manager, but it did not help in practice, so it needs more work before it earns a control here." />

                        <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Open History With" />
                            <TextBox x:Name="HistoryHotkeyBox" Grid.Column="1" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="A system-wide shortcut that opens the clipboard history window, for example Ctrl+Shift+H. Leave it empty for none. It must include at least one of Ctrl, Alt, Shift or Win — a bare key would be taken away from every other program on the machine." />

                        <TextBlock Style="{StaticResource SectionHeading}" Margin="0,0,0,0" Text="During the Gesture" />

                        <CheckBox x:Name="PreservePositionCheck" Content="Reopen on the Clip I Was Last On" />
                        <TextBlock Style="{StaticResource CheckHelp}"
                                   Text="On: the next gesture resumes at the clip you left off on. Off: it always starts at the newest clip. Either way a new copy resets the position to the front." />

                        <CheckBox x:Name="OpenSearchCheck" Content="Open Straight into Search" />
                        <TextBlock Style="{StaticResource CheckHelp}"
                                   Text="Goes directly to the search box instead of the clip list, as though you had pressed F. Useful with a large history; a nuisance if you mostly step back one or two clips." />

                        <CheckBox x:Name="ResetFormatterCheck" Content="Reset the Paste Format on Every Entry" />
                        <TextBlock Style="{StaticResource CheckHelp}"
                                   Text="On: the format returns to the default each time the gesture opens. Off: whatever you last chose with Z is remembered for next time." />

                        <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Default Paste Format" />
                            <ComboBox x:Name="DefaultFormatterCombo" Grid.Column="1" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="Applied to every paste unless you cycle it with Z during the gesture. Original pastes exactly what was copied, keeping formatting; the others strip or reshape the text." />

                        <CheckBox x:Name="WarnAboutConflictCheck"
                                  Content="Tell Me When Another Clipboard Manager Is Running" />
                        <TextBlock Style="{StaticResource CheckHelp}"
                                   Text="Shows a brief notification at start-up if a manager known to claim Ctrl+V is running. It is only a hint — PasteJump cannot tell whether the other program's paste shortcut is actually switched on, so it says what to check rather than claiming anything is broken." />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================================================== Keys -->
            <!--
                Its own tab rather than more rows on Paste Mode, which is already long. The rows are built in
                code from PasteKeyMap.Entries rather than written out here, so a new action appears on this tab
                without anyone remembering to add it - the same bargain the Advanced tab strikes with reflection.
            -->
            <TabItem Header="_Keys">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Margin="0,0,0,10"
                                   Text="Which letter fires each action while the overlay is up. Choose (off) to switch an action off. Only letters can be moved: the arrows, Home, End, Delete, Enter, Esc and F1 stay as they are, so no set of keys can leave you unable to step through the stack or get out of it." />

                        <StackPanel x:Name="PasteKeyRows" />

                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Margin="0,10,0,0"
                                   Text="An action switched off does nothing while the overlay is up — its key is still held back from the application underneath, because the gesture owns the keyboard until you release Ctrl." />

                        <TextBlock x:Name="PasteKeysHintText"
                                   Style="{StaticResource SettingHelp}"
                                   Margin="0,6,0,0" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================================================== Excluded apps -->
            <TabItem Header="E_xcluded Apps">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Margin="0,0,0,10"
                                   Text="While one of these programs is the active window, PasteJump does not read the clipboard at all — so nothing copied inside it is recorded, not even briefly. This is the setting for password managers and banking apps. Matching is on the program's file name, so it applies to every window that program opens." />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- A real list rather than a multi-line text box. The text box put the burden of the
                             format on the user - one per line, extension included, no way to see what was
                             valid - and offered no way to find a program's executable name, which is the
                             part nobody knows off the top of their head. -->
                        <ListBox x:Name="ExcludedList"
                                 Grid.Column="0"
                                 SelectionMode="Extended"
                                 FontFamily="Consolas"
                                 SelectionChanged="OnExcludedSelectionChanged"
                                 ToolTip="Programs PasteJump ignores. Select one or more to remove them." />

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Button x:Name="AddFromRunningButton"
                                    Click="OnAddFromRunningClicked"
                                    Content="Add from _Running…"
                                    Margin="0,0,0,6"
                                    MinWidth="150"
                                    ToolTip="Pick from the programs currently open, so you do not have to know the executable name." />
                            <Button x:Name="BrowseExcludedButton"
                                    Click="OnBrowseExcludedClicked"
                                    Content="Browse for a Program…"
                                    Margin="0,0,0,6"
                                    MinWidth="150"
                                    ToolTip="Choose an .exe on disk. Only its file name is stored, not the path." />
                            <Button x:Name="RemoveExcludedButton"
                                    Click="OnRemoveExcludedClicked"
                                    Content="Re_move"
                                    Margin="0,0,0,6"
                                    MinWidth="150"
                                    IsEnabled="False"
                                    ToolTip="Removes the selected programs from the list." />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Margin="0,0,0,4"
                                   Text="Or type a program's file name and press Enter." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="ExcludedEntryBox"
                                     Grid.Column="0"
                                     FontFamily="Consolas"
                                     KeyDown="OnExcludedEntryKeyDown"
                                     ToolTip="For example keepass.exe. The .exe is added for you if you leave it off." />

                            <Button x:Name="AddExcludedButton"
                                    Grid.Column="1"
                                    Click="OnAddExcludedClicked"
                                    Content="A_dd"
                                    MinWidth="84" />
                        </Grid>

                        <TextBlock x:Name="ExcludedStatusText"
                                   Style="{StaticResource SettingHelp}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ==================================================== Appearance -->
            <TabItem Header="App_earance">
                <ScrollViewer Style="{StaticResource TabScroller}">
                    <StackPanel>

                        <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Theme" />
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="Applies immediately, no restart. &quot;Same as Windows&quot; follows the app colour mode and keeps tracking it if you change it later. Note the notification-area icon does not follow this — it follows the Windows taskbar colour, which is a separate Windows setting." />

                        <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="History List Density" />
                            <ComboBox x:Name="DensityCombo" Grid.Column="1" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="Row spacing in the history window. Compact fits the most rows on screen; Roomy is the easiest to hit with a mouse. An open history window follows the change without reopening." />

                        <TextBlock Style="{StaticResource SectionHeading}" Margin="0,0,0,0" Text="Paste Overlay" />

                        <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Largest Image Preview (px)" />
                            <TextBox x:Name="PreviewWidthBox" Grid.Column="1" />
                            <TextBlock Grid.Column="2" Text="×" Margin="8,0,8,0" />
                            <TextBox x:Name="PreviewHeightBox" Grid.Column="3" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="The most room an image preview may take in the overlay during the gesture. A maximum, not a size — a smaller picture is drawn at its own dimensions and never enlarged. Raise it to judge a screenshot while pasting; lower it to keep the overlay out of the way of the document underneath. Width 120 to 1400, height 80 to 900. Long text previews follow the height too." />

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Characters of Text Shown" />
                            <TextBox x:Name="OverlayPreviewCharsBox" Grid.Column="1" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="How much of a text clip the overlay shows before eliding it, between 40 and 4000. Clipjump showed 200. This is about what is worth reading in the second the gesture lasts, so it is far smaller than the amount stored." />

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fixed Position (x, y)" />
                            <TextBox x:Name="OverlayXBox" Grid.Column="1" />
                            <TextBlock Grid.Column="2" Text="," Margin="8,0,8,0" />
                            <TextBox x:Name="OverlayYBox" Grid.Column="3" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="Leave both empty — the default — to have the overlay appear beside the text caret, or beside the pointer where an application does not report one. Fill in both to pin it to one place on screen instead, in physical pixels from the top-left of the primary monitor. One without the other is not accepted: it would track the caret in one axis and not the other." />

                        <CheckBox x:Name="ShowKeyHintCheck" Content="Show a Key Reminder Along the Bottom" />
                        <TextBlock Style="{StaticResource CheckHelp}"
                                   Text="One muted line naming the keys worth knowing when you have lost your place: A returns to the newest clip, X deletes, Esc cancels, and F1 opens the full list. Turn it off once the gesture is in your fingers." />

                        <TextBlock Style="{StaticResource SectionHeading}" Margin="0,0,0,0" Text="After Each Copy" />

                        <CheckBox x:Name="ShowCopyNotificationCheck"
                                  Content="Show a Brief Notification" />
                        <TextBlock Style="{StaticResource CheckHelp}"
                                   Margin="23,3,0,4"
                                   Text="A small popup near the cursor confirming the copy was recorded, with the clip count and a preview. It never takes focus, and it is suppressed while the paste overlay is open." />

                        <Grid Style="{StaticResource SettingRow}" Margin="23,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="How Long It Stays (ms)" />
                            <TextBox x:Name="CopyNotificationMsBox" Grid.Column="1" />
                        </Grid>
                        <TextBlock Style="{StaticResource CheckHelp}"
                                   Text="Between 1 and 10000 milliseconds. 500 is long enough to read the clip count and gone before it is in the way; raise it if you want to read the preview." />

                        <CheckBox x:Name="BeepOnCopyCheck" Content="Beep" />
                        <TextBlock Style="{StaticResource CheckHelp}"
                                   Margin="23,3,0,4"
                                   Text="A short tone when a clip is recorded. Useful when the notification is off, or when the copy happened on a monitor you were not looking at." />

                        <Grid Style="{StaticResource SettingRow}" Margin="23,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pitch (Hz)" />
                            <TextBox x:Name="BeepFrequencyBox" Grid.Column="1" />
                        </Grid>
                        <TextBlock Style="{StaticResource CheckHelp}"
                                   Text="Between 37 and 32767 hertz. Clipjump used 1500." />

                        <Grid Style="{StaticResource SettingRow}" Margin="23,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Length (ms)" />
                            <TextBox x:Name="BeepDurationBox" Grid.Column="1" />
                        </Grid>
                        <TextBlock Style="{StaticResource CheckHelp}"
                                   Text="Between 20 and 2000 milliseconds. 150 is Clipjump's, and about as long as a tone on every copy can be before it becomes the thing you notice." />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================================================== System -->
            <TabItem Header="_System">
                <ScrollViewer Style="{StaticResource TabScroller}">
                    <StackPanel>

                        <CheckBox x:Name="RunAtLogonCheck" Content="Start PasteJump When I Sign In" />
                        <TextBlock Style="{StaticResource CheckHelp}"
                                   Text="Adds a shortcut to your Startup folder. No scheduled task and no elevation, so it cannot see keystrokes in windows running as administrator." />

                        <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Left-Clicking the Tray Icon" />
                            <ComboBox x:Name="TrayLeftClickCombo" Grid.Column="1" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="Right-clicking always opens the menu, whatever this says — that is the one thing every tray program agrees on, and the way back from any choice here." />

                        <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pause Before Pasting (ms)" />
                            <TextBox x:Name="PasteSettleDelayBox" Grid.Column="1" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Margin="0,3,0,4"
                                   Text="The gap between putting your clip on the clipboard and pressing paste. Raise it if one particular application pastes the previous clip instead of the chosen one — Office and Electron apps hold a cached copy of the clipboard for a moment. 0 to 500." />

                        <!--
                            Per-application overrides. The delay is a property of the program being pasted into
                            rather than of PasteJump, so a single global value meant curing Word by slowing every
                            paste everywhere. Editable in place: two columns is not worth a dialog.
                        -->
                        <TextBlock Text="Longer for particular programs" Style="{StaticResource SectionHeading}" />

                        <DataGrid x:Name="PasteDelayGrid"
                                  Height="116"
                                  Margin="0,6,0,0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="False"
                                  HeadersVisibility="Column"
                                  SelectionMode="Extended">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Program"
                                                    Binding="{Binding Process, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Delay (ms)"
                                                    Binding="{Binding Milliseconds, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <!--
                                Offered rather than applied. Prefilling these silently would change how every paste
                                into a dozen programs behaves on the strength of a guess about someone else's
                                machine - so it is a button, the rows are editable, and nothing is written until OK.
                            -->
                            <Button Content="Add known slow pro_grams"
                                    Click="OnAddKnownSlowProgramsClicked"
                                    ToolTip="Adds Office, Teams, Slack, VS Code, Remote Desktop and the like with a conservative starting delay. Starting points, not measurements — edit them to suit your machine. Programs already listed are left alone." />
                            <Button Content="Add from ru_nning programs…"
                                    Click="OnAddPasteDelayClicked"
                                    ToolTip="Pick a program that currently has a window. It is added with the current global delay, which you can then edit." />
                            <Button Content="Remo_ve"
                                    Click="OnRemovePasteDelayClicked"
                                    ToolTip="Remove the selected rows, so those programs go back to the global delay." />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="Matched on the executable name, so it applies wherever that program runs. Anything not listed uses the delay above." />

                        <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Editor for Text Clips (O key)" />
                            <TextBox x:Name="TextEditorBox" Grid.Column="1" />
                            <!--
                                Browse, because nobody knows an executable's path off the top of their head and a
                                wrong guess fails at the moment you press O rather than here. Same reasoning as
                                the picker on the Excluded Apps tab.
                            -->
                            <Button Grid.Column="2"
                                    Click="OnBrowseTextEditorClicked"
                                    Content="Browse…"
                                    MinWidth="0"
                                    Padding="10,2"
                                    ToolTip="Choose the program to open text clips with" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="Opened when you press O during the gesture on a text clip. The clip is written to a temporary file first; editing it does not change the stored clip." />

                        <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Editor for Image Clips (O key)" />
                            <TextBox x:Name="ImageEditorBox" Grid.Column="1" />
                            <Button Grid.Column="2"
                                    Click="OnBrowseImageEditorClicked"
                                    Content="Browse…"
                                    MinWidth="0"
                                    Padding="10,2"
                                    ToolTip="Choose the program to open image clips with" />
                        </Grid>
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="The same, for a clip that holds a picture. The clip is written to a temporary .bmp first. Text wins when a clip carries both, which is common — copying a table from a browser gives you text and a bitmap at once." />

                        <TextBlock Style="{StaticResource SectionHeading}" Margin="0,0,0,0" Text="Where Data Is Kept" />
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Margin="0,3,0,6"
                                   Text="These two are independent. Changing either needs a restart: PasteJump copies the data across and leaves the old copy behind for you to delete once you are satisfied." />

                        <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Store Clips In" />
                            <ComboBox x:Name="ClipsLocationCombo"
                                      Grid.Column="1"
                                      SelectionChanged="OnDataLocationChanged" />
                        </Grid>
                        <!-- Only meaningful for the custom choice, so it is hidden for the other two rather
                             than sitting there greyed out and inviting a click. -->
                        <Grid x:Name="ClipsCustomRow" Style="{StaticResource SettingRow}" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ClipsCustomPathBox" Grid.Column="0" TextChanged="OnDataLocationPathChanged" />
                            <Button Grid.Column="1"
                                    Click="OnBrowseClipsFolder"
                                    Content="Browse…"
                                    Margin="8,0,0,0"
                                    MinWidth="88" />
                        </Grid>

                        <TextBlock x:Name="ClipsLocationPathText"
                                   Style="{StaticResource PathLink}"
                                   FontFamily="Consolas"
                                   Margin="0,3,0,2"
                                   MouseLeftButtonUp="OnOpenClipsFolder"
                                   ToolTip="Open this folder in File Explorer" />
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="The clip database and the stored images. Choose your user profile if the PasteJump folder is not writable, or to share one history between several copies of PasteJump. Choose a folder of your own for a second drive or somewhere with room for years of images — but not a network share, since two machines writing one database will corrupt it." />

                        <Grid Style="{StaticResource SettingRow}" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Store Settings In" />
                            <ComboBox x:Name="SettingsLocationCombo"
                                      Grid.Column="1"
                                      SelectionChanged="OnDataLocationChanged" />
                        </Grid>
                        <Grid x:Name="SettingsCustomRow" Style="{StaticResource SettingRow}" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SettingsCustomPathBox" Grid.Column="0" TextChanged="OnDataLocationPathChanged" />
                            <Button Grid.Column="1"
                                    Click="OnBrowseSettingsFolder"
                                    Content="Browse…"
                                    Margin="8,0,0,0"
                                    MinWidth="88" />
                        </Grid>

                        <TextBlock x:Name="SettingsLocationPathText"
                                   Style="{StaticResource PathLink}"
                                   FontFamily="Consolas"
                                   Margin="0,3,0,2"
                                   MouseLeftButtonUp="OnOpenSettingsFolder"
                                   ToolTip="Open this folder in File Explorer" />
                        <TextBlock Style="{StaticResource SettingHelp}"
                                   Text="PasteJump.json, holding everything on these tabs. Keeping it beside the program is what lets a portable copy carry its own configuration." />

                        <TextBlock x:Name="VersionText"
                                   Style="{StaticResource SettingHelp}"
                                   Margin="0,8,0,0" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--
                Last in the list, as the reference does it. Built by reflection over PasteJumpSettings, so
                it cannot fall behind the settings that actually exist.
            -->
            <TabItem Header="Ad_vanced">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBox x:Name="AdvancedFilterBox"
                                 Padding="5,2,24,2"
                                 TextChanged="OnAdvancedFilterChanged"
                                 ToolTip="Narrows the list below by setting name or value. To find a setting and jump to its control, use the search box at the top of the dialog." />

                        <Button x:Name="AdvancedFilterClear"
                                Style="{StaticResource SearchClearButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                Visibility="Collapsed"
                                Click="OnAdvancedFilterClearClicked" />

                        <!--
                            "Filter this list", not "Search settings" - that is now the box at the top of the
                            dialog, and two boxes with the same words a few pixels apart do different things.
                        -->
                        <TextBlock x:Name="AdvancedFilterCue"
                                   Text="Filter this list…"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <DataGrid x:Name="AdvancedGrid"
                              Grid.Row="1"
                              SelectionMode="Single"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <!-- Marker column. A glyph rather than colour alone, so "changed" is still
                                 legible to someone who cannot pick the accent hue out of the row. -->
                            <DataGridTemplateColumn Header="" Width="22" CanUserSort="False" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource ModifiedMarkerText}"
                                                   ToolTip="Changed from the default" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding Name}"
                                                Width="1.4*"
                                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding TypeName}"
                                                Width="1.1*"
                                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Value"
                                                Binding="{Binding Value}"
                                                Width="1.2*"
                                                ElementStyle="{StaticResource ModifiedValueText}" />
                            <DataGridTextColumn Header="Default"
                                                Binding="{Binding Default}"
                                                Width="1.2*"
                                                ElementStyle="{StaticResource MutedValueText}" />

                            <!-- Per-setting reset. Nothing is written until OK or Apply, so this is a pending
                                 change like any other and Cancel still abandons it. -->
                            <!-- Wide enough for the button plus the vertical scroll bar, which overlaps the
                                 last column and clipped the label at 64. -->
                            <DataGridTemplateColumn Header="" Width="88" CanUserSort="False" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowResetButton}"
                                                Click="OnResetSettingClicked"
                                                Content="Reset"
                                                Margin="0,0,14,0"
                                                ToolTip="Put this setting back to its default" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip"
                                        Value="{Binding Name, StringFormat='{}{0} — see data\\PasteJump.json'}" />
                                <Style.Triggers>
                                    <!-- Anything changed from its default is worth spotting at a glance; it
                                         is the first thing to check when behaviour is surprising. Weight
                                         alone was far too subtle, so the row is banded and its value is
                                         accented too - see ModifiedValueText and ModifiedMarkerText. -->
                                    <DataTrigger Binding="{Binding IsModified}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Background" Value="{DynamicResource ModifiedRowBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="AdvancedStatus"
                                   Grid.Column="0"
                                   Margin="2,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />

                        <!--
                            Access keys picked around the ones that are always live - the tab headers and the three
                            dialog buttons. R and I are free; the obvious letters are not: E and X belong to the
                            Appearance and Excluded Apps tabs, P to Paste Mode, T to Capture, and O to OK.
                        -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ExportSettingsButton"
                                    Click="OnExportSettingsClicked"
                                    Content="Expo_rt…"
                                    MinWidth="96"
                                    ToolTip="Write every setting to a JSON file you choose. Where the clips and settings are kept is not included — those are paths that only mean something on this machine." />

                            <Button x:Name="ImportSettingsButton"
                                    Click="OnImportSettingsClicked"
                                    Content="_Import…"
                                    MinWidth="96"
                                    ToolTip="Read settings from a file exported earlier. Nothing is saved until you press OK or Apply, so Cancel still abandons it." />

                            <Button x:Name="ResetAllButton"
                                    Click="OnResetAllClicked"
                                    Content="Reset A_ll to Defaults"
                                    MinWidth="160"
                                    ToolTip="Put every setting back to the value a fresh install would have" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

        <TextBlock x:Name="ValidationText"
                   Grid.Row="2"
                   Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Visibility="Collapsed" />

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="AppliedText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="12"
                       Visibility="Collapsed" />

            <!-- OK, Cancel, Apply - the Windows property-sheet order. Apply sits outermost because it is
                 the one you press repeatedly, and Cancel between them is what every other settings dialog
                 on the machine does. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Click="OnOkClicked" Content="_OK" IsDefault="True"
                        ToolTip="Save and close" />
                <Button x:Name="CancelButton" Click="OnCancelClicked" Content="_Cancel" IsCancel="True"
                        ToolTip="Close without saving anything not already applied" />
                <Button x:Name="ApplyButton" Click="OnApplyClicked" Content="_Apply"
                        ToolTip="Save now and keep this window open, so you can try a value and adjust it" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
