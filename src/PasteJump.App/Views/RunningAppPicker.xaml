<Window x:Class="PasteJump.App.Views.RunningAppPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PasteJump - choose programs"
        Width="880"
        Height="520"
        MinWidth="620"
        MinHeight="320"
        Background="{DynamicResource SurfaceBrush}"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display">

    <!--
        Exists because nobody knows executable names off the top of their head. Asking someone to type
        "1password.exe" to exclude 1Password is asking them to guess, and a wrong guess fails silently - the
        entry simply never matches. Picking from what is running removes the guess.

        Only programs with a visible window are listed. The full process table is mostly services and
        background hosts, none of which can ever be the foreground window, so including them would bury the
        dozen entries that matter.
    -->

    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="88" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="11"
                   Text="Programs with a window open. Select one or more — only the file name is added, so the exclusion applies whenever that program runs, not just to this instance." />

        <DataGrid x:Name="AppsGrid"
                  Grid.Row="1"
                  SelectionMode="Extended"
                  MouseDoubleClick="OnRowDoubleClick"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <!--
                    The icon is what makes this list scannable. A column of executable names is a column of
                    near-identical text, and the whole reason this dialog exists is that people know programs
                    by their icon and their name in the Start menu, not by their file name.

                    Sizing is fixed rather than Auto: an Auto column would resize as rows virtualise in and
                    out, making the grid shift under the pointer while scrolling.
                -->
                <DataGridTemplateColumn Header="" Width="42" CanUserSort="False" IsReadOnly="True">
                    <!--
                        The width alone was never the whole problem, and raising it without this style would
                        not have fixed it either: the themed DataGridCell carries Padding="10,0", so of the
                        30px this column used to have, 20 went to padding and the 16px image was handed 10 -
                        which Stretch=Uniform then obediently shrank it into. Hence a near-invisible icon in a
                        column that looked wide enough.

                        BasedOn is mandatory, as everywhere else in this project: an explicit CellStyle
                        replaces the themed one outright rather than merging, so without it this cell would
                        lose its ControlTemplate and its selection colours.
                    -->
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="Padding" Value="4,0" />
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--
                                Uniform, NOT None. CreateBitmapSourceFromHIcon hands back the icon at whatever
                                size the executable actually provides, commonly 32x32 - and Stretch=None does
                                not scale it down to the box, it CROPS it, so every icon rendered as its own
                                top-left quarter. Uniform fits whatever arrives.

                                24 rather than 16: these are program icons being identified by eye, and the
                                source is usually a 32px frame, so it is downscaled either way - the smaller
                                box threw away detail for no reason. 42 of column minus 8 of padding leaves
                                34, comfortably more than this needs.
                            -->
                            <Image Source="{Binding Icon}"
                                   Width="24"
                                   Height="24"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Program"
                                    Binding="{Binding FileName}"
                                    Width="1.1*"
                                    ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Window"
                                    Binding="{Binding WindowTitle}"
                                    Width="1.4*"
                                    ElementStyle="{StaticResource MutedValueText}" />

                <!-- Truncated at the end, with the whole path on a tooltip. Losing the tail is tolerable only
                     because the file name has its own column beside this one - see PathCellText. -->
                <DataGridTextColumn Header="Path"
                                    Binding="{Binding PathText}"
                                    Width="2.2*"
                                    ElementStyle="{StaticResource PathCellText}" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="CountText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="11" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AddButton"
                        Click="OnAddClicked"
                        Content="_Add"
                        IsDefault="True" />
                <Button Content="_Cancel"
                        Click="OnCancelClicked"
                        IsCancel="True" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
