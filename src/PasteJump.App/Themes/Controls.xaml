<!--
    Implicit control styles, shared by both themes.

    This file exists because theming a window's Background is not enough. WPF's built-in control
    templates carry their own hard-coded light chrome, so before this the dark theme produced white
    text boxes with black text, pale grey grid headers and light scroll bars against a #1E1E22 window
    - which is what "dark is not looking good" was describing. Everything below draws its colours from
    the palette tokens instead.

    All palette references use DynamicResource, never StaticResource. The tokens live in a sibling
    dictionary (Light.xaml or Dark.xaml) that ThemeManager swaps at runtime; a StaticResource would
    resolve once at parse time and then never change, so the theme selector would appear to do nothing
    until restart.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================ scroll bars -->

    <!-- The page-track areas either side of the thumb. Invisible but still hit-testable, so
         click-to-page-scroll keeps working. -->
    <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Body"
                            Background="{DynamicResource ScrollThumbBrush}"
                            CornerRadius="4"
                            Margin="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background"
                                    Value="{DynamicResource ScrollThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Body" Property="Background"
                                    Value="{DynamicResource ScrollThumbHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="11" />
        <Setter Property="MinWidth" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <!-- IsDirectionReversed: a vertical scroll bar's value grows downwards. -->
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Style="{StaticResource ScrollTrackButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Style="{StaticResource ScrollTrackButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="11" />
                <Setter Property="MinHeight" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                      Style="{StaticResource ScrollTrackButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand"
                                                      Style="{StaticResource ScrollTrackButton}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ text -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!--
        Implicit rather than keyed, which is the whole point: WPF's built-in Hyperlink is a fixed blue with a
        permanent underline, and that blue is illegible on the dark palette. Anywhere a link is added without
        remembering to style it, this is what catches it.

        The underline appears on hover only. A permanently underlined link inside a sentence competes with the
        text around it, and the accent colour already carries the affordance - Windows 11's own dialogs do the
        same. Foreground has to be re-stated on hover as well, or the pointer turns the link WPF's blue: the
        built-in template's own IsMouseOver trigger would otherwise win over this setter.
    -->
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,4" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
        <Setter Property="SelectionTextBrush" Value="{DynamicResource SelectionTextBrush}" />

        <!-- Centred suits a single-line box; the AcceptsReturn trigger below switches multi-line boxes
             to Top. The template binds to this rather than hard-coding Center, which previously made
             every multi-line box - the clip preview, the ignore list - float its text mid-height. -->
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ControlDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- A multi-line box is a text area, so its content sits at the top, not centred. -->
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ buttons -->

    <!--
        Shaped after the Windows 11 push button, because that is the yardstick a user actually compares
        against - the Run dialog sitting next to ours.

        Three things carry that look, and the first is the one that matters most:

        1. The default button is FILLED with the accent, not outlined with it. An outline-only default is
           the pre-Windows-10 convention and is what makes an otherwise fine button read as dated.
        2. CornerRadius 4 and MinHeight 32. Win11's button is 4px and roomier than WPF's default; a 3px
           radius on a short button reads as "nearly square" rather than deliberately rounded.
        3. A 1px border in a slightly darker tone than the fill, so the button has an edge at rest
           instead of floating.

        Triggered on IsDefault rather than IsDefaulted. IsDefaulted goes false whenever focus moves to
        another focusable control, so the fill would flicker away as soon as the user tabbed - whereas
        Win11 keeps its default button filled the whole time.
    -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--
                            Ordering is load-bearing. WPF applies matching triggers in declaration order,
                            so the default-button fill has to come BEFORE the hover and pressed triggers -
                            otherwise a filled default button would revert to the plain grey hover colour
                            the moment the pointer touched it.
                        -->
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource ControlPressedBrush}" />
                        </Trigger>

                        <!-- Re-stated for the default button, since the two triggers above have just
                             overwritten its fill with the neutral one. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource AccentHoverBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource AccentPressedBrush}" />
                        </MultiTrigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource ControlHoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource BorderBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ControlDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ check box -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Box"
                                Grid.Column="0"
                                Width="15"
                                Height="15"
                                CornerRadius="3"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1">
                            <!-- Drawn rather than a glyph font, so it renders identically at any DPI
                                 and needs no font fallback. -->
                            <Path x:Name="Tick"
                                  Data="M 2,5.5 L 5,8.5 L 10,2.5"
                                  Stroke="White"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed" />
                        </Border>

                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ControlDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ combo box -->

    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Path x:Name="Arrow"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Data="M 0,0 L 4,4 L 8,0"
                              Stroke="{DynamicResource MutedTextBrush}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--
                            Disabled first, so hover cannot re-light a control that cannot be used - trigger
                            order is declaration order, and a later IsMouseOver would otherwise win.
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource SurfaceBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource BorderBrush}" />
                            <Setter TargetName="Arrow" Property="Stroke"
                                    Value="{DynamicResource ControlDisabledTextBrush}" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource SelectionBrush}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource SelectionTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" />

                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False" />

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,2,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10"
                                                      ShadowDepth="2"
                                                      Opacity="0.35"
                                                      Color="{DynamicResource ShadowColor}" />
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ControlDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ group box -->

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <StackPanel>
                        <!-- Header above the box rather than notched into the border: the default
                             GroupBox template draws a hard-coded light double line. -->
                        <TextBlock Text="{TemplateBinding Header}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="2,0,0,4" />
                        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ data grid -->

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="RowHeight" Value="28" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />

        <!-- Every grid here has a star-sized column, so there is never anything to scroll to
             horizontally - and an always-present horizontal scrollbar just eats a row of height. -->
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />

        <!--
            Grid lines off, separation carried by the row rhythm and a hairline drawn per row instead.

            WPF's HorizontalGridLinesBrush paints a full-width line in one flat colour and offers no
            control over inset or opacity, so on a dark surface it reads as heavy banding. Drawing the
            separator inside the row template keeps it a true hairline and lets it disappear under
            selection, where a line through a highlighted row just looks like a defect.
        -->
    </Style>

    <!-- Sort glyph. Drawn rather than a font glyph so it needs no fallback and stays crisp at any DPI. -->
    <Style x:Key="SortGlyph" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="SeparatorBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <!--
                            The right border carries the column rule up into the header, so the rules do not start
                            below it and read as unfinished. Same brush as the cell's, at the same opacity: the
                            header's own bottom border is a full-strength line, and a column rule matching THAT
                            would turn the head of the list into a grid.
                        -->
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />

                                <!-- Chevron up for ascending, down for descending. Only one is ever
                                     visible; both are declared so the swap is a trigger, not layout. -->
                                <Path x:Name="SortUp"
                                      Grid.Column="1"
                                      Style="{StaticResource SortGlyph}"
                                      Data="M 0,4 L 3.5,0 L 7,4" />
                                <Path x:Name="SortDown"
                                      Grid.Column="1"
                                      Style="{StaticResource SortGlyph}"
                                      Data="M 0,0 L 3.5,4 L 7,0" />

                                <!-- Sits in the padding, like the cell's, so it lands on the column boundary. -->
                                <Rectangle Grid.Column="1"
                                           Width="1"
                                           HorizontalAlignment="Right"
                                           Margin="0,6,-10,6"
                                           Fill="{DynamicResource BorderBrush}"
                                           Opacity="0.45"
                                           SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>

                        <!-- Column resize grips. Part names are required by DataGrid. -->
                        <Thumb x:Name="PART_LeftHeaderGripper"
                               HorizontalAlignment="Left"
                               Width="6"
                               Cursor="SizeWE"
                               Opacity="0" />
                        <Thumb x:Name="PART_RightHeaderGripper"
                               HorizontalAlignment="Right"
                               Width="6"
                               Cursor="SizeWE"
                               Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortUp" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortDown" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <!-- Transparent throughout: hover and selection are painted once by the row, so cells must
             not each paint their own or the row reads as a strip of separate blocks. -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />

        <!--
            Stretch, not the inherited default of Left.

            DataGridCell.HorizontalContentAlignment defaults to Left, which makes the ContentPresenter
            shrink to its content and sit at the left edge. A column whose ElementStyle sets
            HorizontalAlignment="Right" then has no room to move within it, so right-alignment silently
            does nothing - which is exactly why the Size column stayed left-aligned.
        -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />

                            <!--
                                Column separator, drawn in the cell rather than by GridLinesVisibility for the same
                                reason the row hairline is: WPF's VerticalGridLinesBrush is a flat, full-height line
                                with no control over inset or opacity, and it paints straight through a selected
                                row - which reads as a defect rather than as a rule.

                                Inset top and bottom, dimmed, and hidden under selection, so the eye gets columns
                                without the list turning into a spreadsheet. The rule sits in the PADDING, outside
                                the content: Margin's right value is the negative of the cell's own right padding,
                                which puts it on the cell boundary rather than 10px inside it.
                            -->
                            <Rectangle x:Name="ColumnRule"
                                       Width="1"
                                       HorizontalAlignment="Right"
                                       Margin="0,5,-10,5"
                                       Fill="{DynamicResource BorderBrush}"
                                       Opacity="0.45"
                                       SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!--
                            Gone on the selected row. Not on hover, unlike the row hairline: hover moves with the
                            pointer, and rules blinking out of one row at a time as it travels down the list is
                            more distracting than the rules themselves. Selection is where the contrast problem is
                            real, since the accent fill is what the line would cut across.
                        -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ColumnRule" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <!--
                        Border thickness is always 1, transparent when unselected. Toggling the
                        thickness instead would change the row's inner size the moment it was selected,
                        which shifts every cell by a pixel and makes the list twitch as you arrow
                        through it.
                    -->
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="2"
                            Margin="1,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Hairline separator, inset from both edges so the list does not look
                                 ruled. Hidden under selection and hover, where a line through a
                                 highlighted row just looks like a defect. -->
                            <Rectangle x:Name="Separator"
                                       Height="1"
                                       VerticalAlignment="Bottom"
                                       Margin="9,0"
                                       Fill="{DynamicResource BorderBrush}"
                                       Opacity="0.55" />

                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource ControlHoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource HoverBorderBrush}" />
                            <Setter TargetName="Separator" Property="Visibility" Value="Hidden" />
                        </Trigger>

                        <!-- Selection last, so it wins over hover when both apply. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource SelectionBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource SelectionBorderBrush}" />
                            <Setter TargetName="Separator" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Cell text styles.

        Foreground is bound to the owning DataGridCell rather than left to inheritance. It has to be:
        the app-level implicit TextBlock style sets Foreground explicitly, and an explicit setter beats
        property inheritance - so a selected cell's foreground change would never reach the TextBlock
        inside it, and selected rows kept the unselected text colour.
    -->
    <Style x:Key="CellText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
    </Style>

    <!-- Numbers read far better right-aligned and monospaced: the digits line up by magnitude, so
         relative size is legible without reading the units. -->
    <Style x:Key="NumericCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="FontFamily" Value="Consolas" />
    </Style>

    <!-- Muted but left-aligned, for a secondary text column such as "Default". -->
    <Style x:Key="MutedValueText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}"
                         Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        The value of a setting that differs from its default.

        Three cues, not one, and the redundancy is the point. The row also carries a background tint, but a
        tint alone is easy to miss when scanning and disappears entirely under selection; weight alone -
        which is all this used to have - proved far too subtle to spot at a glance. Colour is not doing the
        work on its own either, because the row carries a marker glyph as well, so the state survives being
        read by someone who cannot distinguish the accent hue.

        Selection wins, as everywhere else: accent-coloured text on a saturated selection fill is unreadable.
    -->
    <Style x:Key="ModifiedValueText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsModified}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}"
                         Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The marker itself. Hidden rather than blank so the column keeps its width and the rows stay aligned. -->
    <Style x:Key="ModifiedMarkerText" TargetType="TextBlock">
        <Setter Property="Text" Value="●" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Visibility" Value="Hidden" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsModified}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}"
                         Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        A file path in a grid cell. Muted like any secondary column, with a trailing ellipsis and the whole path
        on a tooltip.

        Trailing is the only option WPF offers - TextTrimming has no leading-ellipsis mode, so a path can be cut
        at the end or not at all. That is acceptable here only because the file name, which is the part a path
        is usually truncated to preserve, already has a column of its own beside this one. Without that column
        this would need a converter that shortens the middle.
    -->
    <Style x:Key="PathCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding PathText}" />
        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}"
                         Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MutedCellText" TargetType="TextBlock" BasedOn="{StaticResource NumericCellText}">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Style.Triggers>
            <!-- Muted is right for an unselected row-number, but muted text on a saturated selection
                 background is unreadable, so selection has to win here as well. -->
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}"
                         Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ list box -->

    <!--
        Added the moment a ListBox first appeared in the app, and it had to be: with no style here WPF falls
        back to its built-in chrome, which is a white background and a blue system highlight. In dark mode that
        is a glaring white panel - the same failure the DataGrid work fixed, and the reason every control this
        app uses needs a template before it is used rather than after someone notices.
    -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <!-- Border thickness stays 1 and only its brush changes, as in DataGridRow: toggling the
                         thickness on selection shifts the content by a pixel and makes the list twitch as you
                         arrow through it. -->
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="2"
                            Margin="1,0"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource ControlHoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource HoverBorderBrush}" />
                        </Trigger>

                        <!-- Selection last, so it wins over hover when both apply. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource SelectionBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource SelectionBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ControlDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ tabs -->

    <!--
        Categories run down the left, not across the top.

        A horizontal tab strip forces every label onto one line, so it either truncates or drives the
        dialog wider than its content needs; and with five or more categories it reads as a crowded
        ribbon. A vertical list is the convention for settings dialogs of this shape - Explorer's
        Options, Visual Studio's, System Informer's - because category names are variable-length and a
        left column absorbs that without affecting the panel beside it.
    -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <!-- Settings is the only TabControl in the app, so this tracks that dialog's text size. -->
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- Border thickness constant, transparent when unselected: see the note on the
                         DataGridRow template for why toggling thickness makes the list twitch. -->
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="10,7"
                            Margin="0,0,0,1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource ControlHoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource HoverBorderBrush}" />
                        </MultiTrigger>

                        <!-- Same gradient-and-outline selection as the list rows, so the two surfaces
                             agree about what "selected" looks like. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource SelectionBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource SelectionBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Categories" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4,0,0,4"
                                Padding="5"
                                MinWidth="132">
                            <!-- StackPanel, not TabPanel: TabPanel lays items out in rows for a
                                 horizontal strip and gives no vertical arrangement. -->
                            <StackPanel IsItemsHost="True" Orientation="Vertical" />
                        </Border>

                        <Border Grid.Column="1"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,1,1"
                                CornerRadius="0,4,4,0"
                                Padding="14">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ misc -->

    <!--
        A thin dark seam inside a wider transparent grab area.

        Those two widths have to differ. Drawing a 1px splitter directly would make the divider look
        right and be almost impossible to grab with a mouse; keeping the control wide and painting a
        hairline inside it gives a crisp 1px line with a comfortable ~6px hit target.
    -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Rectangle x:Name="Line"
                                   Width="1"
                                   HorizontalAlignment="Center"
                                   Fill="{DynamicResource SplitterLineBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Horizontal splitter: the seam runs the other way. -->
                        <Trigger Property="ResizeDirection" Value="Rows">
                            <Setter TargetName="Line" Property="Width" Value="Auto" />
                            <Setter TargetName="Line" Property="Height" Value="1" />
                            <Setter TargetName="Line" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="Line" Property="VerticalAlignment" Value="Center" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Fill" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Tooltips wrap, and they are the one place in this application where that had to be arranged rather than
        asked for.

        A string assigned to ToolTip is rendered by a TextBlock that ContentPresenter generates, and its
        TextWrapping defaults to NoWrap - so a sentence of explanation became a single line as wide as it needed
        to be, about 1,000px for the Remove Duplicates button, running past the window and off towards the other
        monitor. Neither MaxWidth on its own nor Padding fixes that: without wrapping the text is simply clipped
        at the limit instead.

        The wrapping is arranged with an implicit DataTemplate for String, declared in the template's own
        resources. Two alternatives were tried or considered and are worse:

          - An implicit TextBlock STYLE in the same place does nothing, which was measured rather than guessed:
            the tooltip came out exactly 380px wide with TextWrapping still NoWrap - the width limit honoured and
            the text clipped at it, which looks almost right in a screenshot. An implicit style does not reach a
            TextBlock that ContentPresenter generates from its internal template.
          - Setting ContentTemplate outright would work and applies to *all* content, so the day a tooltip is
            given a Grid or a StackPanel it would render as the type name - silently. Keying the template on
            String means element content still goes through ContentPresenter untouched.

        Declared inside ControlTemplate.Resources rather than at dictionary level, and that scoping is the whole
        safety of it: an implicit String template in Application.Resources would capture the string content of
        every Button, Label and header in the application.

        MaxWidth is on the ToolTip rather than the TextBlock so the border and padding are inside the limit, and
        it is deliberately narrow: prose is easier to read in a column than in a line, and every tooltip here is
        prose. TextFormattingMode=Display for the same reason the overlay and the toast set it - this is 12px
        text, which WPF's default Ideal mode renders visibly soft.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MaxWidth" Value="380" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <ControlTemplate.Resources>
                        <DataTemplate DataType="{x:Type sys:String}">
                            <TextBlock Text="{Binding}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextBrush}" />
                        </DataTemplate>
                    </ControlTemplate.Resources>

                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        THE TRAY MENU.

        These templates exist because without them the menu was the one surface that ignored the theme: a WPF
        ContextMenu with no style renders in WPF's own light chrome, so right-clicking the tray on Nord or Dracula
        produced a white menu beside a dark application. Nothing was styled here at all - TrayMenuBuilder's only
        two colour settings were the invisible owner window's - and it was reported.

        Adapted from AltTab.NET's Themes/Controls.xaml, which had solved the same problem, and every brush below is
        an existing PaletteKeys entry, so no theme file gained a key. DynamicResource throughout: ThemeManager
        swaps the palette dictionary wholesale, and a StaticResource here would keep the colour it had at start-up.

        The four-column grid is shared by every item so check marks, labels, glyphs and gesture text line up down
        the menu rather than each item measuring itself.
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Keyed on MenuItem.SeparatorStyleKey, not TargetType alone: a menu's separators are styled by that key, and
        an ordinary Separator style does not reach them - which shows up as a separator that keeps the default
        chrome inside an otherwise themed menu.
    -->
    <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Background" Value="{DynamicResource SplitterLineBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            Margin="4,0"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <Grid Height="26">
                            <Grid.ColumnDefinitions>
                                <!-- Glyph or check mark, label, gesture, submenu arrow. -->
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                            </Grid.ColumnDefinitions>

                            <!--
                                One column, two possible occupants, and the check mark wins: it is state, while
                                the glyph is decoration, and a tick hidden behind an icon would be unreadable.
                                The glyph inherits Foreground rather than setting its own, which is what makes the
                                disabled trigger below reach it too.
                            -->
                            <ContentPresenter x:Name="Icon"
                                              Grid.Column="0"
                                              ContentSource="Icon"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />

                            <TextBlock x:Name="Check"
                                       Grid.Column="0"
                                       Text="&#x2713;"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Visibility="Collapsed" />

                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0" />

                            <!--
                                InputGestureText. WPF does not draw it for you inside a custom template, which is
                                easy to miss: the accelerators simply do not appear and the menu looks subtly less
                                helpful than it did before it was themed.
                            -->
                            <TextBlock x:Name="Gesture"
                                       Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <Path x:Name="Arrow"
                                  Grid.Column="3"
                                  Data="M 0,0 L 4,4 L 0,8 Z"
                                  Fill="{DynamicResource MutedTextBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />

                            <!--
                                Submenus are drawn even though the tray menu has none today: a nested item that
                                silently rendered as an unopenable row would be a trap for whoever adds the first
                                one, and the popup is a dozen lines.
                            -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Right"
                                   HorizontalOffset="-4"
                                   VerticalOffset="-6"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="0,4"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource ControlHoverBrush}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ControlDisabledTextBrush}" />
                            <Setter TargetName="Gesture" Property="Foreground"
                                    Value="{DynamicResource ControlDisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
