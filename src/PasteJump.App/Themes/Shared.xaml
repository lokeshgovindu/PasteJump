<!--
    Theme-independent shared resources: the window icon and named styles that are not control chrome.

    These live in a merged dictionary rather than directly in Application.Resources so they are
    addressable by pack:// URI. That matters for anything that composes the resource set without going
    through App.xaml - the UI smoke harness does exactly that, and resources declared inline in
    Application.Resources are invisible to it, which shows up as "Cannot find resource named …" at the
    first control that needs one.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        There is deliberately no AppIcon resource here, and no window sets Window.Icon.

        A BitmapImage decodes exactly ONE frame of an .ico, so binding Window.Icon to one hands Windows a
        single bitmap to answer every size with - and no single choice is right. Decoding without a size
        picked the smallest, 16, and the taskbar drew it visibly undersized. Forcing 256 fixed the size and
        made it blurry, because reducing 8:1 destroys a 1px rim and a one-pixel gap. Forcing 32 is exact at
        100% scaling and wrong again at 150%.

        With no Window.Icon, Windows falls back to the executable's icon from the PE header - all nine frames,
        via ApplicationIcon in the csproj - and picks the right one per surface and per DPI itself. That is
        what Explorer has been doing correctly all along, and it is the only option that needs no guess about
        which size will be asked for.

        Consequence worth knowing: windows hosted by another executable show that executable's icon, so the UI
        smoke harness shows its own. Not a defect - it is the same fallback working as intended.
    -->

    <!--
        The mark for anything that *displays* it rather than using it as a window icon.

        A separate resource, and a PNG rather than the .ico, because a multi-frame icon is the wrong source
        for a chosen render size: WPF's icon decoder picks a frame itself, and given no requested decode size
        it can pick a small one and scale it up. That is exactly what made the About window's 48px image look
        soft - it was a 32px frame enlarged. One frame at 256 removes the choice, and downscaling is always
        cleaner than the reverse.

        Generated by tools/generate-icon.ps1 -PngPath, so it cannot drift from the icon.
    -->
    <BitmapImage x:Key="AppIconLarge" UriSource="pack://application:,,,/PasteJump;component/Assets/pastejump-256.png" />

    <!-- Small muted label used for the overlay's status chips. -->
    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        The clear button that sits at the right-hand end of a search box. Defined here rather than per window so the
        three of them - the settings search, the Advanced filter and the history search - cannot drift apart.

        Its own template rather than the themed Button style: that one carries a border, a background and a minimum
        width meant for a dialog button, all of which look wrong on a glyph inside a text field. Transparent
        background rather than none, because a null background is not hit-testable and the button would only
        respond on the glyph itself.

        Sized 18x18 and vertically centred by the caller. The glyph is U+2715 MULTIPLICATION X, which is the shape
        Windows uses for this and reads better at small sizes than a letter x or U+00D7.
    -->
    <Style x:Key="SearchClearButton" TargetType="Button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="ToolTip" Value="Clear (Esc)" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="9">
                        <TextBlock x:Name="Glyph"
                                   Text="&#x2715;"
                                   FontSize="10"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
