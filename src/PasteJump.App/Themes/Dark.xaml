<!--
    Dark palette. Must define exactly the same keys as Light.xaml - see the note there.

    Accent, warn and danger are deliberately lighter than their light-theme counterparts rather than
    shared. #2563EB reads as navy against a #1E1E22 surface and fails contrast at small sizes; lifting
    it keeps the hue recognisable while staying legible.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1E1E22" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FF2A2A31" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FF3C3C45" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFECECF1" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF9A9AA6" />

    <!-- Semantic -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF6C9BFA" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFE0A030" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFE8695B" />

    <!--
        Accent fill for the default button. See the note in Light.xaml.

        The text on it is dark, not light. The dark theme's accent is a pale blue - chosen so it stays
        legible as *text* on a dark surface - and pale blue is far too light to carry white text. This is
        the one place where the two themes invert rather than mirror, and using AccentTextBrush from the
        light palette here would give unreadable white-on-pale-blue.
    -->
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF83ADFB" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF5A85DC" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF10131C" />

    <!-- Control chrome -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF17171B" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF4A4A56" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF353540" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FF43434F" />
    <SolidColorBrush x:Key="ControlDisabledTextBrush" Color="#FF6E6E7A" />
    <!-- Same gradient-plus-outline treatment as the light theme; see the note there. Darker and more
         saturated so it reads as a lit selection against a dark surface rather than a grey wash. -->
    <LinearGradientBrush x:Key="SelectionBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF3F6AAE" />
        <GradientStop Offset="1" Color="#FF2C4B7C" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#FF6191CE" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#FF43434F" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FF4C4C58" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FF666674" />

    <!-- See the note in Light.xaml. Darker than the surrounding surfaces here, not lighter: a dark
         seam reads as a division, whereas a light one reads as a highlight. -->
    <SolidColorBrush x:Key="SplitterLineBrush" Color="#FF121215" />

    <Color x:Key="ShadowColor">#FF000000</Color>

</ResourceDictionary>
