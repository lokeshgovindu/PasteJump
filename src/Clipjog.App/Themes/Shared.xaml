<!--
    Theme-independent shared resources: the window icon and named styles that are not control chrome.

    These live in a merged dictionary rather than directly in Application.Resources so they are
    addressable by pack:// URI. That matters for anything that composes the resource set without going
    through App.xaml - the UI smoke harness does exactly that, and resources declared inline in
    Application.Resources are invisible to it, which shows up as "Cannot find resource named …" at the
    first control that needs one.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Title-bar and Alt+Tab icon for every window, referenced by each Window.Icon.

        Theme-independent, unlike the tray icon: a window's title bar is drawn by DWM over the window's
        own frame, so one coloured icon is correct in both light and dark.
    -->
    <BitmapImage x:Key="AppIcon" UriSource="pack://application:,,,/Clipjog;component/Assets/clipjog.ico" />

    <!-- Small muted label used for the overlay's status chips. -->
    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
