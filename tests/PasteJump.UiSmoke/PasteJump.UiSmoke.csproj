<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI smoke harness. Not shipped.

    Constructs and shows every PasteJump window, in both themes, with the real theme dictionaries
    loaded, and reports any exception.

    This exists because a bad ControlTemplate compiles perfectly: templates are only applied when a
    control is instantiated, so a passing `dotnet build` says nothing about whether the windows
    actually open. It is not an xUnit project because WPF windows need an STA thread with a real
    Application and a message pump, which is awkward to arrange inside a test host - a console exit
    code is enough for CI to gate on.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PasteJump.UiSmoke</AssemblyName>
    <RootNamespace>PasteJump.UiSmoke</RootNamespace>
    <StartupObject>PasteJump.UiSmoke.Program</StartupObject>
    <IsPackable>false</IsPackable>

    <!-- PasteJump.App is a self-contained win-x64 executable, and NETSDK1151 forbids a
         non-self-contained executable referencing one. Match it rather than fight it. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PasteJump.App\PasteJump.App.csproj" />
  </ItemGroup>

</Project>
