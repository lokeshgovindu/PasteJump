<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!--
    All build output goes to artifacts/ at the repo root, so src/ and tests/ hold only sources.

    This is the SDK's own mechanism rather than hand-set OutputPath/BaseIntermediateOutputPath: those
    two have to be set in the right order relative to the SDK import to work at all, and setting
    BaseIntermediateOutputPath late silently leaves obj/ behind because NuGet restore has already read
    the old value. UseArtifactsOutput moves both, and only works from a Directory.Build.props sitting
    beside the solution file - which is why this cannot move into the individual projects.

    Layout is artifacts/bin/<project>/<config> and artifacts/obj/<project>/<config>. Two things about
    that leaf folder catch out anything hard-coding a path: it is lowercase ("debug", not "Debug"), and
    a project with a RuntimeIdentifier gets the RID appended with an underscore - so PasteJump.App
    builds to "debug_win-x64" while PasteJump.Core builds to plain "debug".

    Consequence worth knowing: Debug and Release now have separate data/ folders beneath their own
    output directories, so a debug run and a release run no longer share a clipboard history. Set the
    data location to the user profile (see AppPaths) if you want one history across both.
  -->
  <PropertyGroup Label="Output layout">
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <!--
    What Windows shows about the file. Each of these lands in the Win32 version resource and in the assembly
    attributes, and they are read in more places than is obvious:

      Product     -> "Product name" in the Details tab, and the group name in Task Manager's process list.
      Company     -> "Company". A person, not "PasteJump" - the product is not its own publisher, and this is
                     the field a code-signing certificate's subject would have to agree with. Naming the product
                     here was simply wrong.
      AssemblyTitle -> the Win32 FileDescription, which is the MOST visible of the lot: Task Manager shows it as
                     the process's friendly name, and the SmartScreen and UAC prompts show it above everything
                     else. NOT <Description>, which is what it looks like it should be - that becomes the
                     assembly description and appears nowhere in Explorer. Verified by reading the built exe
                     rather than assumed, having first set the wrong one. It defaulted to the assembly name, so
                     a build announced itself as the bare word "PasteJump" at exactly the moment a user is
                     deciding whether to trust it; a sentence saying what the program is does more work there.
      Description -> the managed assembly description. Kept in step with the title by hand, since nothing reads
                     both.
      Copyright   -> "Copyright".
      Trademark   -> left empty deliberately. There is no registered mark, and claiming one is a false statement
                     in a legal field rather than a harmless label.
  -->
  <PropertyGroup Label="Product identity">
    <Product>PasteJump</Product>
    <Company>Lokesh Govindu</Company>
    <Authors>Lokesh Govindu</Authors>
    <AssemblyTitle>PasteJump - keyboard-driven clipboard manager</AssemblyTitle>
    <Description>PasteJump - keyboard-driven clipboard manager</Description>
    <Copyright>Copyright (c) 2026 Lokesh Govindu</Copyright>
    <PasteJumpAuthorUrl>https://github.com/lokeshgovindu</PasteJumpAuthorUrl>
    <PasteJumpRepositoryUrl>https://github.com/lokeshgovindu/PasteJump</PasteJumpRepositoryUrl>
  </PropertyGroup>

  <!--
    Author and profile URL as assembly metadata, because neither is readable at runtime otherwise:
    <Authors> is a NuGet packaging property and produces no assembly attribute, and <Company> is
    "PasteJump" rather than a person. The About window needs both to turn the name inside the copyright
    line into a link, and reading them from here keeps one definition instead of a second copy in XAML
    that would go stale the first time only one was updated.

    Constant values, so unlike the build timestamp in PasteJump.App.csproj these do not make every
    build recompile.
  -->
  <ItemGroup Label="Product identity">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Author</_Parameter1>
      <_Parameter2>$(Authors)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AuthorUrl</_Parameter1>
      <_Parameter2>$(PasteJumpAuthorUrl)</_Parameter2>
    </AssemblyAttribute>

    <!-- Read by the update check, which derives the GitHub API URL from it, and by the About window's link.
         One definition so the two cannot point at different repositories. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryUrl</_Parameter1>
      <_Parameter2>$(PasteJumpRepositoryUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Versioning: major.minor.build.revision, year-based major. Set here so every project and the
    published exe carry the same number.

    Three properties, because MSBuild treats them differently and getting it wrong produces a build
    that reports the wrong version:

      AssemblyVersion   - the strong identity. Four parts, and the ONLY one Win32 shows in the file
                          properties dialog. Must stay parseable as four integers.
      FileVersion       - the Win32 FILEVERSION resource. Kept identical to AssemblyVersion.
      InformationalVersion - free-form, and what the app displays. Left equal to the numeric version
                          here; note the SDK appends "+<commit sha>" to it unless
                          IncludeSourceRevisionInInformationalVersion is disabled, which is exactly
                          the sort of thing that ends up in a tray tooltip by accident.

    Version itself is deliberately NOT set: it defaults from these and setting it as well is how the
    three drift apart.

    HOW TO BUMP IT: edit PasteJumpVersionBase - the first three parts - and nothing else. The REVISION
    is not written down anywhere: it is the number of commits reachable from HEAD, computed by
    ResolvePasteJumpRevision in Directory.Build.targets, so every commit gets its own version without
    anyone having to remember. That is deliberate rather than convenient - a revision typed by hand is
    one that gets forgotten, and a version-bump line in every diff is noise that also conflicts on
    every merge.

    2026.1 has not been released, so the major and minor stay where they are; a minor bump was tried
    here and reverted for exactly that reason.

    Consequences worth knowing:

      - Uncommitted work carries the LAST commit's revision. The number moves when you commit, not
        when you edit, which is the whole point: a given commit always builds the same version.
      - The value below is the fallback for a tree with no git - a source download, or a build where
        git is not on PATH. It is also overridable: -p:PasteJumpRevision=123.
      - A shallow clone counts only the commits it fetched. CI, if there ever is any, needs the full
        history (fetch-depth: 0) or it will produce versions that go backwards.
  -->
  <PropertyGroup Label="Versioning">
    <PasteJumpVersionBase>2026.1.0</PasteJumpVersionBase>

    <!--
      Set before the default below, and the order is the whole trick: anything already in
      PasteJumpRevision at this point came from outside - the command line or the environment - because
      nothing in the repository has assigned it yet. ResolvePasteJumpRevision reads this flag and leaves
      the value alone, which is what makes -p:PasteJumpRevision=123 work. A global property is normally
      immutable, but one assigned inside a target wins, so without the flag the git count silently
      overrode whatever was passed in.
    -->
    <PasteJumpRevisionWasSpecified Condition="'$(PasteJumpRevision)' != ''">true</PasteJumpRevisionWasSpecified>
    <PasteJumpRevision Condition="'$(PasteJumpRevision)' == ''">0</PasteJumpRevision>
    <PasteJumpVersion>$(PasteJumpVersionBase).$(PasteJumpRevision)</PasteJumpVersion>
    <AssemblyVersion>$(PasteJumpVersion)</AssemblyVersion>
    <FileVersion>$(PasteJumpVersion)</FileVersion>
    <InformationalVersion>$(PasteJumpVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    ICU note: on Windows 10 1903+ .NET uses the OS-provided icu.dll, so a
    self-contained build does not ship icudt.dat. Leaving InvariantGlobalization
    false therefore costs no size, and we need culture-aware case-insensitive
    comparison for search over arbitrary clipboard text.
  -->
  <PropertyGroup>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

</Project>
